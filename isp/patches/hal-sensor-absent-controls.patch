           mWdrMode(0),
           // HDR_FEATURE_E
           mCurFll(0),
-          mCalculatingFrameDuration(true) {
+          mCalculatingFrameDuration(true),
+          mDigitalGainCtrl(-1),
+          mTestPatternCtrl(-1),
+          mVblankCtrl(-1),
+          mHblankCtrl(-1) {
     LOG1("<id%d> @%s", mCameraId, __func__);
     // CRL_MODULE_S
     /**
@@ -135,11 +139,30 @@ int SensorHwCtrl::getPixelRate(int& pixelRate) {
     return ret;
 }
 
+bool SensorHwCtrl::canSetControl(int id, int& state) {
+    if (state < 0) {
+        v4l2_queryctrl query = {};
+        query.id = id;
+        state = (mPixelArraySubdev->QueryControl(&query) == OK &&
+                 (query.flags & (V4L2_CTRL_FLAG_READ_ONLY | V4L2_CTRL_FLAG_DISABLED)) == 0)
+                    ? 1 : 0;
+        if (state == 0) {
+            LOGI("<id%d> sensor control 0x%x is absent or read-only, not setting it",
+                 mCameraId, id);
+        }
+    }
+    return state == 1;
+}
+
 int SensorHwCtrl::setTestPatternMode(int32_t testPatternMode) {
     HAL_TRACE_CALL(CAMERA_DEBUG_LOG_LEVEL2);
     CheckAndLogError(mPixelArraySubdev == nullptr, NO_INIT, "pixel array sub device is not set");
 
     LOG2("@%s, testPatternMode: %d", __func__, testPatternMode);
+    if (!canSetControl(V4L2_CID_TEST_PATTERN, mTestPatternCtrl)) {
+        // Off is what a sensor without the control does anyway.
+        return testPatternMode == 0 ? OK : BAD_VALUE;
+    }
     return mPixelArraySubdev->SetControl(V4L2_CID_TEST_PATTERN, testPatternMode);
 }
 
@@ -275,6 +298,9 @@ int SensorHwCtrl::setDigitalGains(const vector<int>& digitalGains) {
     // CRL_MODULE_E
 
     LOG2("%s digitalGain=%d", __func__, digitalGains[0]);
+    if (!canSetControl(V4L2_CID_DIGITAL_GAIN, mDigitalGainCtrl)) {
+        return OK;
+    }
     int status = mPixelArraySubdev->SetControl(V4L2_CID_DIGITAL_GAIN, digitalGains[0]);
     CheckAndLogError((status != 0), status, "failed to set digitalGain gain %d.", digitalGains[0]);
 
