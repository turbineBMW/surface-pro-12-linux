+// Stored as CAMERA_STATISTICS_FACE_RECTANGLES; "no faces" is one empty rectangle
+// so that the entry always has a payload.
+int Parameters::setFaceRegions(const std::vector<int32_t>& rects) {
+    ParameterHelper::AutoWLock wl(mData);
+    if (rects.size() < 4U) {
+        const int32_t none[4] = {0, 0, 0, 0};
+        return ParameterHelper::getMetadata(mData).update(CAMERA_STATISTICS_FACE_RECTANGLES, none,
+                                                          4);
+    }
+    return ParameterHelper::getMetadata(mData).update(CAMERA_STATISTICS_FACE_RECTANGLES,
+                                                      rects.data(), rects.size() / 4U * 4U);
+}
+
+int Parameters::getFaceRegions(std::vector<int32_t>& rects) const {
+    ParameterHelper::AutoRLock rl(mData);
+    auto entry = ParameterHelper::getMetadataEntry(mData, CAMERA_STATISTICS_FACE_RECTANGLES);
+    if ((entry.count == 0) || ((entry.count % 4) != 0)) {
+        return NAME_NOT_FOUND;
+    }
+    rects.clear();
+    for (size_t i = 0U; i < entry.count; i += 4U) {
+        const int32_t* r = &entry.data.i32[i];
+        if ((r[2] > r[0]) && (r[3] > r[1])) {
+            rects.insert(rects.end(), r, r + 4);
+        }
+    }
+    return OK;
+}
