+/*
+ * Faces found outside the HAL (Parameters::setFaceRegions, in active-array
+ * pixels), handed to 3A as the PVL face detector would hand its own: the
+ * Linux release has no detector, so face-based AE otherwise never runs.
+ * Only faces in this call's parameters count, so a stale list is not
+ * re-applied with every later parameter change.
+ */
+static void updateExternalFaces(int cameraId, const Parameters& param) {
+    std::vector<int32_t> rects;
+    if (!PlatformData::isExternalFaceAeEnabled(cameraId) || (param.getFaceRegions(rects) != OK)) {
+        return;
+    }
+
+    auto staticMetadata = PlatformData::getStaticMetadata(cameraId);
+    auto it = staticMetadata->mInt32Metadata.find("sensor.info.activeArraySize");
+    if ((it == staticMetadata->mInt32Metadata.end()) || (it->second.size() < 4U)) {
+        LOGW("<id%d> @%s: no active array size, faces ignored", cameraId, __func__);
+        return;
+    }
+    const std::vector<int32_t>& a = it->second;
+    const camera_coordinate_system_t activeArray = {a[0], a[1], a[0] + a[2], a[1] + a[3]};
+
+    auto aiqResultStorage = CameraContext::getInstance(cameraId)->getAiqResultStorage();
+    FaceDetectionResult* buf = aiqResultStorage->acquireFaceResult();
+    CLEAR(*buf);
+    buf->ccaFaceState.updated = true;
+    buf->ccaFaceState.is_video_conf = true;
+    // What the Windows stack reports for its own detector (centernet_tracking).
+    buf->ccaFaceState.fd_algo = CENTERNET_FD;
+
+    uint32_t num = 0U;
+    for (size_t i = 0U; (i + 3U < rects.size()) && (num < MAX_FACES_DETECTABLE); i += 4U) {
+        const camera_coordinate_t lt =
+            AiqUtils::convertToIaCoordinate(activeArray, {rects[i], rects[i + 1]});
+        const camera_coordinate_t rb =
+            AiqUtils::convertToIaCoordinate(activeArray, {rects[i + 2], rects[i + 3]});
+        ia_atbx_face& face = buf->ccaFaceState.faces[num];
+        face.face_area.left = lt.x;
+        face.face_area.top = lt.y;
+        face.face_area.right = rb.x;
+        face.face_area.bottom = rb.y;
+        face.tracking_id = static_cast<int32_t>(num);
+        face.confidence = 100;
+        face.person_id = -1;
+        LOG2("<id%d> @%s: face %u at %d,%d,%d,%d (IA)", cameraId, __func__, num,
+             face.face_area.left, face.face_area.top, face.face_area.right,
+             face.face_area.bottom);
+        num++;
+    }
+    buf->ccaFaceState.num_faces = num;
+
+    static int64_t sFaceSequence = 0;
+    aiqResultStorage->updateFaceResult(++sFaceSequence);
+}
+
 int CameraHal::setParameters(int cameraId, const Parameters& param) {
     LOG2("<id%d> @%s", cameraId, __func__);
     CameraDevice* device = mCameraDevices[cameraId];
     checkCameraDevice(device, BAD_VALUE);
 
+    updateExternalFaces(cameraId, param);
     mParameters[cameraId].merge(param);
 
     DataContext dataContext(cameraId);
