#!/bin/bash
# Reconnect the Flex Keyboard over Bluetooth when it is detached.
#
# The keyboard advertises ADV_DIRECT_IND at its bonded host's *public* identity.
# bluetoothd's background auto-connect did not pick this up on this system, but
# an explicit connect (which puts the controller in the initiator state) does.
# This just issues that connect, with retries, when the wired KIP endpoints go.
#
# If every retry fails, the stored bond is very likely stale (e.g. Windows
# re-keyed the keyboard on a dual boot): the keyboard is right here and
# advertising, yet will not accept our key. We record that in a marker so
# sp12-flex-autopair re-pairs on the next attach. A successful connect clears it.
set -u
hid_devices=${SP12_FLEX_HID_DEVICES:-/sys/bus/hid/devices}
address_file=${SP12_FLEX_ADDRESS_FILE:-/etc/sp12/flex-keyboard-address}
run_dir=${SP12_FLEX_RUN_DIR:-/run/sp12}
marker=$run_dir/flex-needs-repair

mkdir -p "$run_dir"

# SP12_FLEX_NO_SLEEP skips the waits, for testing.
nap(){ [[ -n ${SP12_FLEX_NO_SLEEP:-} ]] || sleep "$1"; }

# sp12-pen-pair turns LE privacy on while it pairs a pen, and the
# keyboard cannot connect then: it advertises to the host's public address.
# Wait for privacy to go off before acting. After such a wait the keyboard may
# have stopped advertising, so a link that does not come up says nothing about
# the bond: it is kept, and a stale one still shows on the next detach.
# pen-pair changes privacy with the radio off (power off, privacy, power on), so
# privacy reads off a moment before the radio is back: wait for both.
privacy_on(){ btmgmt info 2>/dev/null | grep -m1 'current settings:' | tr -s ' \t' '\n' | grep -qx privacy; }
powered(){ bluetoothctl show 2>/dev/null | grep -q 'Powered: yes'; }
wait_privacy_off(){
    for _ in $(seq 1 180); do privacy_on || { powered && return 0; }; nap 1; done
    return 1
}

KBD="${1:-}"
[ -n "$KBD" ] || KBD=$(cat "$address_file" 2>/dev/null || true)
[ -n "$KBD" ] || exit 0

waited=0
privacy_on && waited=1
if ! wait_privacy_off; then
    logger -t sp12-flex-bt-autoconnect "Bluetooth privacy is still on (a pen is pairing); not connecting $KBD"
    exit 0
fi

# Already connected? nothing to do.
bluetoothctl info "$KBD" 2>/dev/null | grep -q 'Connected: yes' && { rm -f "$marker"; exit 0; }

n=0
restarts=0
while [ "$n" -lt 10 ]; do
    n=$((n + 1))
    # Still attached over the wire? then we are not wanted.
    ls "$hid_devices" 2>/dev/null | grep -q '045E:0C8B' && exit 0
    # A pen pairing began between tries. Nothing else starts this job again,
    # so wait it out and start the tries over rather than give up; a few
    # pairings in a row are waited out, not an endless run of them.
    if privacy_on; then
        waited=1
        restarts=$((restarts + 1))
        if [ "$restarts" -gt 3 ] || ! wait_privacy_off; then
            logger -t sp12-flex-bt-autoconnect "Bluetooth privacy keeps coming on (a pen is pairing); not connecting $KBD"
            exit 0
        fi
        n=0
        continue
    fi
    timeout 25 bluetoothctl connect "$KBD" >/dev/null 2>&1
    if bluetoothctl info "$KBD" 2>/dev/null | grep -q 'Connected: yes'; then
        logger -t sp12-flex-bt-autoconnect "connected $KBD over Bluetooth"
        rm -f "$marker"
        exit 0
    fi
    # Half-way with nothing: a wedged in-flight LE connect in the kernel makes
    # every connect a silent "busy" until the controller is reset. Reset once,
    # but never around a pen pairing: that would cut the pairing off, or drop
    # the pen it just paired, and the keyboard may simply have stopped
    # advertising by then (see above).
    if [ "$n" = 5 ] && [ "$waited" = 0 ] && ! privacy_on && powered; then
        logger -t sp12-flex-bt-autoconnect "no connection after $n tries; power-cycling the controller once"
        btmgmt power off >/dev/null 2>&1; nap 2; btmgmt power on >/dev/null 2>&1; nap 4
    fi
    nap 3
done
# Exhausted retries with the keyboard detached: flag a likely-stale bond so the
# next attach re-pairs. Only if it is still detached (not a race with re-attach).
if [ "$waited" = 1 ] || privacy_on; then
    logger -t sp12-flex-bt-autoconnect "failed to connect $KBD around a pen pairing; not flagging the bond"
elif ! ls "$hid_devices" 2>/dev/null | grep -q '045E:0C8B'; then
    : > "$marker" 2>/dev/null || true
    logger -t sp12-flex-bt-autoconnect "failed to connect $KBD after retries; flagged for re-pair on next attach"
else
    logger -t sp12-flex-bt-autoconnect "failed to connect $KBD after retries (re-attached during attempt)"
fi
