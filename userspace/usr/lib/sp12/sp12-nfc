#!/usr/bin/python3
# Surface Pro 12 (Intel): NFC reader daemon for the PN560 (nxp-nci).
#
# Keeps the kernel NFC device polling and reports every tag, card or phone it
# reads to user sessions, so a desktop plugin can chime and show the read, and
# scripts can react to it.
#
# Why a daemon: the NFC netlink commands need CAP_NET_ADMIN, and the PN560 only
# sees passive cards when discovery includes a listen phase (dual mode: reader
# protocols plus NFC-DEP target mode), which no stock userspace on this system
# asks for. See docs/peripheral-plan.md, 8b.
#
# What "read" means, per target:
#   Type 2 tags (NTAG, MIFARE Ultralight): the NDEF message (text, URI, ...).
#   ISO-DEP (ISO 14443-4) cards and phones: the NDEF Type 4 application if
#     present, else the payment application list (PPSE: brand, label, AID).
#     Nothing beyond the directory is read: no PAN, no records.
#   FeliCa, ISO 15693, Jewel: identity only.
#
# Output, one JSON object per line:
#   /run/sp12-nfc/events   Unix stream socket; every connected client gets
#                          each event as it happens, plus a "reader" event on
#                          connect.
#   /run/sp12-nfc/last     the last "card" event (for scripts and `sp12-nfc last`).
#
# Signals: SIGHUP restarts discovery (use it after resume), SIGTERM stops
# polling and takes the device down before exiting (never remove nxp-nci while
# the device is up: it deadlocks).
import ctypes
import errno
import json
import os
import select
import signal
import socket
import struct
import sys
import time

RUN_DIR = os.environ.get("RUNTIME_DIRECTORY", "/run/sp12-nfc")
SOCK_PATH = os.path.join(RUN_DIR, "events")
LAST_PATH = os.path.join(RUN_DIR, "last")

# Netlink / generic netlink.
NETLINK_GENERIC, GENL_ID_CTRL, CTRL_CMD_GETFAMILY = 16, 0x10, 3
CTRL_ATTR_FAMILY_ID, CTRL_ATTR_FAMILY_NAME, CTRL_ATTR_MCAST_GROUPS = 1, 2, 7
NLM_F_REQUEST, NLM_F_ACK, NLM_F_DUMP = 1, 4, 0x300
NLMSG_ERROR, NLMSG_DONE = 2, 3
SOL_NETLINK, NETLINK_ADD_MEMBERSHIP = 270, 1

# linux/nfc.h
CMD_GET_DEVICE, CMD_DEV_UP, CMD_DEV_DOWN = 1, 2, 3
CMD_START_POLL, CMD_STOP_POLL, CMD_GET_TARGET = 6, 7, 8
EVENT_TARGETS_FOUND, EVENT_DEVICE_ADDED, EVENT_DEVICE_REMOVED, EVENT_TARGET_LOST = 9, 10, 11, 12
ATTR_DEVICE_INDEX, ATTR_DEVICE_NAME, ATTR_PROTOCOLS, ATTR_TARGET_INDEX = 1, 2, 3, 4
ATTR_SENS_RES, ATTR_SEL_RES, ATTR_NFCID1, ATTR_SENSB_RES, ATTR_SENSF_RES = 5, 6, 7, 8, 9
ATTR_DEVICE_POWERED, ATTR_IM_PROTOCOLS, ATTR_TM_PROTOCOLS = 12, 13, 14
ATTR_ISO15693_DSFID, ATTR_ISO15693_UID = 26, 27
PROTO_JEWEL, PROTO_MIFARE, PROTO_FELICA, PROTO_ISO14443, PROTO_NFC_DEP = 1, 2, 3, 4, 5
PROTO_ISO14443_B, PROTO_ISO15693 = 6, 7
PROTO_NAMES = {PROTO_JEWEL: "Type 1 (Jewel)", PROTO_MIFARE: "Type 2 (MIFARE)", PROTO_FELICA: "FeliCa",
               PROTO_ISO14443: "ISO14443-A", PROTO_NFC_DEP: "NFC-DEP", PROTO_ISO14443_B: "ISO14443-B",
               PROTO_ISO15693: "ISO15693"}
ALL_IM = sum(1 << p for p in PROTO_NAMES)
AF_NFC, NFC_SOCKPROTO_RAW = 39, 0

# Same fixed UID seen again within this window is the same presence: no new event.
QUIET_SECS = 3.0
# Pause between a detection and the next discovery cycle.
REPOLL_DELAY = 0.6

# EMV application identifiers, RID (first 5 bytes) to brand.
BRANDS = {"a000000003": "Visa", "a000000004": "Mastercard", "a000000025": "American Express",
          "a000000152": "Discover", "a000000065": "JCB", "a000000333": "UnionPay",
          "a000000277": "Interac", "a000000324": "Discover", "a000000042": "CB",
          "a000000359": "Girocard", "a000000677": "Debit Network Alliance", "a000000384": "eftpos",
          "a000000620": "MIR", "a000000291": "PayPass", "a000000098": "US Debit (Visa)",
          "a000000305": "Maestro", "d276000025": "Girocard"}

seq = 0


