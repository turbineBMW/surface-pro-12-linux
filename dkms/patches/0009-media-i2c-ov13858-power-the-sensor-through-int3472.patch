Subject: media: i2c: ov13858: power the sensor through its INT3472 resources

On the Surface Pro 12 (Intel), OVTID858 (\_SB.PC00.I2C3.CAMR) gets its
AVDD, reset and 19.2 MHz clock from an INT3472 (ICL0), and nothing turns
them on before probe, so the chip-ID read fails with -EIO ("failed to find
sensor: -5").

Take an optional reset GPIO and the "avdd" supply, enable them with the
clock for probe and runtime PM, and power down on suspend and remove. The
supply falls back to a dummy regulator and the GPIO is optional, so
platforms that power the sensor through ACPI (e.g. the Surface Pro 9)
behave as before.

Based on zR-JB's 0101-ov13858-sp12-power.patch (linux-surface#2144).
---
--- a/drivers/media/i2c/ov13858.c
+++ b/drivers/media/i2c/ov13858.c
@@ -3,9 +3,12 @@
 
 #include <linux/acpi.h>
 #include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
 #include <linux/i2c.h>
 #include <linux/module.h>
 #include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
 #include <media/v4l2-ctrls.h>
 #include <media/v4l2-device.h>
 #include <media/v4l2-event.h>
@@ -1031,6 +1034,8 @@ static const struct ov13858_mode supported_modes[] = {
 struct ov13858 {
 	struct device *dev;
 	struct clk *clk;
+	struct gpio_desc *reset;
+	struct regulator *avdd;
 
 	struct v4l2_subdev sd;
 	struct media_pad pad;
@@ -1655,6 +1660,41 @@ static void ov13858_free_controls(struct ov13858 *ov13858)
 	mutex_destroy(&ov13858->mutex);
 }
 
+static int ov13858_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct ov13858 *ov13858 = to_ov13858(sd);
+
+	gpiod_set_value_cansleep(ov13858->reset, 1);
+	clk_disable_unprepare(ov13858->clk);
+	regulator_disable(ov13858->avdd);
+
+	return 0;
+}
+
+static int ov13858_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct ov13858 *ov13858 = to_ov13858(sd);
+	int ret;
+
+	ret = regulator_enable(ov13858->avdd);
+	if (ret)
+		return ret;
+
+	ret = clk_prepare_enable(ov13858->clk);
+	if (ret) {
+		regulator_disable(ov13858->avdd);
+		return ret;
+	}
+
+	gpiod_set_value_cansleep(ov13858->reset, 0);
+	/* Let the supply settle and give the sensor its 8192 XVCLK cycles. */
+	msleep(20);
+
+	return 0;
+}
+
 static int ov13858_probe(struct i2c_client *client)
 {
 	struct ov13858 *ov13858;
@@ -1678,14 +1718,34 @@ static int ov13858_probe(struct i2c_client *client)
 				     "external clock %lu is not supported\n",
 				     freq);
 
+	/*
+	 * On platforms where an INT3472 provides the sensor's power (e.g. the
+	 * Surface Pro 12), nothing enables it before probe; elsewhere these are
+	 * absent and ACPI power management keeps handling the sensor.
+	 */
+	ov13858->reset = devm_gpiod_get_optional(ov13858->dev, "reset",
+						 GPIOD_OUT_HIGH);
+	if (IS_ERR(ov13858->reset))
+		return dev_err_probe(ov13858->dev, PTR_ERR(ov13858->reset),
+				     "failed to get reset GPIO\n");
+
+	ov13858->avdd = devm_regulator_get(ov13858->dev, "avdd");
+	if (IS_ERR(ov13858->avdd))
+		return dev_err_probe(ov13858->dev, PTR_ERR(ov13858->avdd),
+				     "failed to get avdd regulator\n");
+
 	/* Initialize subdev */
 	v4l2_i2c_subdev_init(&ov13858->sd, client, &ov13858_subdev_ops);
 
+	ret = ov13858_power_on(ov13858->dev);
+	if (ret)
+		return dev_err_probe(ov13858->dev, ret, "failed to power on\n");
+
 	/* Check module identity */
 	ret = ov13858_identify_module(ov13858);
 	if (ret) {
 		dev_err(ov13858->dev, "failed to find sensor: %d\n", ret);
-		return ret;
+		goto error_power_off;
 	}
 
 	/* Set default mode to max resolution */
@@ -1693,7 +1753,7 @@ static int ov13858_probe(struct i2c_client *client)
 
 	ret = ov13858_init_controls(ov13858);
 	if (ret)
-		return ret;
+		goto error_power_off;
 
 	/* Initialize subdev */
 	ov13858->sd.internal_ops = &ov13858_internal_ops;
@@ -1714,10 +1774,7 @@ static int ov13858_probe(struct i2c_client *client)
 	if (ret < 0)
 		goto error_media_entity;
 
-	/*
-	 * Device is already turned on by i2c-core with ACPI domain PM.
-	 * Enable runtime PM and turn off the device.
-	 */
+	/* The device is powered on; enable runtime PM and let it idle. */
 	pm_runtime_set_active(ov13858->dev);
 	pm_runtime_enable(ov13858->dev);
 	pm_runtime_idle(ov13858->dev);
@@ -1731,6 +1788,9 @@ error_handler_free:
 	ov13858_free_controls(ov13858);
 	dev_err(ov13858->dev, "%s failed:%d\n", __func__, ret);
 
+error_power_off:
+	ov13858_power_off(ov13858->dev);
+
 	return ret;
 }
 
@@ -1744,8 +1804,14 @@ static void ov13858_remove(struct i2c_client *client)
 	ov13858_free_controls(ov13858);
 
 	pm_runtime_disable(ov13858->dev);
+	if (!pm_runtime_status_suspended(ov13858->dev))
+		ov13858_power_off(ov13858->dev);
+	pm_runtime_set_suspended(ov13858->dev);
 }
 
+static DEFINE_RUNTIME_DEV_PM_OPS(ov13858_pm_ops, ov13858_power_off,
+				 ov13858_power_on, NULL);
+
 static const struct i2c_device_id ov13858_id_table[] = {
 	{ .name = "ov13858" },
 	{ }
@@ -1766,6 +1832,7 @@ static struct i2c_driver ov13858_i2c_driver = {
 	.driver = {
 		.name = "ov13858",
 		.acpi_match_table = ACPI_PTR(ov13858_acpi_ids),
+		.pm = pm_ptr(&ov13858_pm_ops),
 	},
 	.probe = ov13858_probe,
 	.remove = ov13858_remove,
