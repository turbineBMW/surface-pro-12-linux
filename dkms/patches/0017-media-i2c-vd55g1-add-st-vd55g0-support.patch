+/*
+ * SP11 bring-up DEBUG (do not commit): optionally hold the sensor rails,
+ * MCLK and reset active during power-on so the bus can be inspected, and
+ * sweep the local CCI bus for ACKs when the sensor does not respond.
+ */
+static unsigned int power_hold_ms;
+module_param(power_hold_ms, uint, 0644);
+MODULE_PARM_DESC(power_hold_ms,
+		 "DEBUG: hold sensor powered N ms before the first FSM read");
+
+static bool scan_on_fail = true;
+module_param(scan_on_fail, bool, 0644);
+MODULE_PARM_DESC(scan_on_fail,
+		 "DEBUG: on FSM wait failure, sweep own I2C bus 0x08-0x77 for ACKs");
+
+static unsigned int addr_override;
+module_param(addr_override, uint, 0444);
+MODULE_PARM_DESC(addr_override,
