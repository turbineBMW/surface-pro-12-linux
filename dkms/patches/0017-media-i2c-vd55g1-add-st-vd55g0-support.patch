 	if (sensor->ae_ctrl->is_new)
 		vd55g1_write(sensor, VD55G1_REG_EXP_MODE(0), expo_state, &ret);
 
@@ -886,10 +970,20 @@ static int vd55g1_read_expo_cluster(struct vd55g1 *sensor)
 	u64 dgain = 0;
