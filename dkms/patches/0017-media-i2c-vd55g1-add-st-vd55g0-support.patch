+#define VD55G0_REG_GROUP_HOLD				CCI_REG8(0x0448)
+#define VD55G0_REG_ANALOG_GAIN				CCI_REG8(0x044d)
+#define VD55G0_REG_COARSE_EXPOSURE			CCI_REG16_LE(0x044e)
+#define VD55G0_REG_DIGITAL_GAIN			CCI_REG16_LE(0x0450)
+#define VD55G0_FRAME_LENGTH				1955
+#define VD55G0_EXPO_MAX					1947
+#define VD55G0_EXPO_DEF					1200
+#define VD55G0_AGAIN_DEF				24 /* 4x */
+/*
+ * The Windows resolution records declare 644x604; the context geometry
+ * registers (0x045c/0x0460, +0x2c per context) hold size-minus-one
+ * (603/643). Do not touch them: the firmware faults (FSM=0xff, err=0x2)
+ * if they disagree with the boot-time OIF configuration.
