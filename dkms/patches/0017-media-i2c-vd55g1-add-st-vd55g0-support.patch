+/*
+ * VD55G0: apply the Windows camx configuration verbatim (clock tree, MIPI
+ * rate, geometry, firmware AE) and start streaming with the camx handshake.
+ */
+static int vd55g0_enable_streams(struct vd55g1 *sensor)
+{
+	unsigned int i;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(sensor->dev);
+	if (ret < 0)
+		return ret;
+
+	ret = 0;
+	for (i = 0; i < ARRAY_SIZE(vd55g0_win_config); i++)
+		vd55g1_write(sensor, CCI_REG8(vd55g0_win_config[i].addr),
+			     vd55g0_win_config[i].val, &ret);
+
+	/* Apply the current V4L2 exposure/gain control values */
+	vd55g1_write(sensor, VD55G0_REG_COARSE_EXPOSURE,
+		     sensor->expo_ctrl->val, &ret);
+	vd55g1_write(sensor, VD55G0_REG_ANALOG_GAIN,
+		     sensor->again_ctrl->val, &ret);
+	vd55g1_write(sensor, VD55G0_REG_DIGITAL_GAIN,
+		     sensor->dgain_ctrl->val, &ret);
+
+	if (ret)
+		goto err_rpm_put;
+
+	vd55g1_write(sensor, VD55G1_REG_STBY, VD55G1_STBY_START_STREAM, &ret);
+	vd55g1_poll_reg(sensor, VD55G0_REG_ERROR_FLAGS, 0, &ret);
+	vd55g1_poll_reg(sensor, VD55G1_REG_STBY, 0, &ret);
+	vd55g1_wait_state(sensor, VD55G1_SYSTEM_FSM_STREAMING, &ret);
+	if (ret)
+		goto err_rpm_put;
+
+	dev_info(sensor->dev, "vd55g0 streaming\n");
+	return 0;
+
+err_rpm_put:
+	{
+		u64 fsm = 0, err_flags = 0, oif_ppl = 0, xw = 0, yh = 0;
+
+		vd55g1_read(sensor, VD55G0_REG_SYSTEM_FSM, &fsm, NULL);
+		vd55g1_read(sensor, VD55G0_REG_ERROR_FLAGS, &err_flags, NULL);
+		vd55g1_read(sensor, CCI_REG16_LE(0x0306), &oif_ppl, NULL);
+		vd55g1_read(sensor, CCI_REG16_LE(0x0460), &xw, NULL);
+		vd55g1_read(sensor, CCI_REG16_LE(0x045c), &yh, NULL);
+		dev_err(sensor->dev,
+			"vd55g0 stream start failed %d: fsm=0x%llx err=0x%llx ppl=%llu xw=%llu yh=%llu\n",
+			ret, fsm, err_flags, oif_ppl, xw, yh);
+	}
+	pm_runtime_put(sensor->dev);
+	return -EINVAL;
+}
+
+static int vd55g0_disable_streams(struct vd55g1 *sensor)
+{
+	int ret = 0;
+
+	vd55g1_write(sensor, VD55G1_REG_STREAMING,
+		     VD55G1_STREAMING_STOP_STREAM, &ret);
+	vd55g1_wait_state(sensor, VD55G1_SYSTEM_FSM_SW_STBY, &ret);
+	if (ret)
