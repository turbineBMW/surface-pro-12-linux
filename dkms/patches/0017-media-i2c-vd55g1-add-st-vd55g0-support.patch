+static void vd55g1_debug_scan_bus(struct device *dev)
+{
+	struct i2c_client *client = to_i2c_client(dev);
+	struct i2c_adapter *adap = client->adapter;
+	int nack = 0, timeout = 0, other = 0;
+	u8 dummy;
+	u16 addr;
+
+	dev_info(dev, "DEBUG: scanning %s (0x08-0x77), sensor powered\n",
+		 adap->name);
+
+	for (addr = 0x08; addr <= 0x77; addr++) {
+		struct i2c_msg msg = {
+			.addr = addr,
+			.flags = I2C_M_RD,
+			.len = 1,
+			.buf = &dummy,
+		};
+		int ret = i2c_transfer(adap, &msg, 1);
+
+		if (ret == 1)
+			dev_info(dev, "DEBUG: ACK at 0x%02x\n", addr);
+		else if (ret == -ENXIO)
+			nack++;
+		else if (ret == -ETIMEDOUT)
+			timeout++;
+		else
+			other++;
+	}
+	dev_info(dev, "DEBUG: scan done: %d NACK, %d timeout, %d other\n",
+		 nack, timeout, other);
+}
