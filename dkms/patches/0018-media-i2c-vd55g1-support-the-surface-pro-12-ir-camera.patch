diff --git a/drivers/media/i2c/vd55g1.c b/drivers/media/i2c/vd55g1.c
--- a/drivers/media/i2c/vd55g1.c
+++ b/drivers/media/i2c/vd55g1.c
@@ -5,6 +5,7 @@
  * Copyright (C) 2025 STMicroelectronics SA
  */
 
+#include <linux/acpi.h>
 #include <linux/clk.h>
 #include <linux/delay.h>
 #include <linux/gpio/consumer.h>
@@ -491,6 +492,17 @@ static const char * const vd55g1_supply_name[] = {
 	"vana",
 };
 
+/*
+ * On ACPI platforms (Surface Pro 12 Intel) an INT3472 provides the rails as
+ * "dovdd" (I/O) and "avdd" (analogue); the core supply is not switched.
+ */
+static const char * const vd55g1_acpi_supply_name[] = {
+	"vcore",
+	"dovdd",
+	"avdd",
+};
+static_assert(ARRAY_SIZE(vd55g1_acpi_supply_name) == ARRAY_SIZE(vd55g1_supply_name));
+
 enum vd55g1_hdr_mode {
 	VD55G1_NO_HDR,
 	VD55G1_HDR_SUB,
@@ -2195,6 +2207,10 @@ static int vd55g1_parse_dt(struct vd55g1 *sensor)
 	endpoint = fwnode_graph_get_endpoint_by_id(dev_fwnode(sensor->dev),
 						   0, 0, 0);
 	if (!endpoint) {
+		/* On ACPI systems ipu-bridge creates it when the IPU probes. */
+		if (is_acpi_node(dev_fwnode(sensor->dev)))
+			return dev_err_probe(sensor->dev, -EPROBE_DEFER,
+					     "waiting for fwnode graph endpoint\n");
 		dev_err(sensor->dev, "Endpoint node not found\n");
 		return -EINVAL;
 	}
@@ -2264,8 +2280,11 @@ static int vd55g1_get_regulators(struct vd55g1 *sensor)
 {
 	unsigned int i;
 
+	const char * const *names = is_acpi_node(dev_fwnode(sensor->dev)) ?
+		vd55g1_acpi_supply_name : vd55g1_supply_name;
+
 	for (i = 0; i < ARRAY_SIZE(vd55g1_supply_name); i++)
-		sensor->supplies[i].supply = vd55g1_supply_name[i];
+		sensor->supplies[i].supply = names[i];
 
 	return devm_regulator_bulk_get(sensor->dev,
 				       ARRAY_SIZE(vd55g1_supply_name),
@@ -2389,6 +2408,13 @@ static const struct of_device_id vd55g1_dt_ids[] = {
 };
 MODULE_DEVICE_TABLE(of, vd55g1_dt_ids);
 
+static const struct acpi_device_id vd55g1_acpi_ids[] = {
+	/* Surface Pro 12 (Intel) IR camera */
+	{ "SMO55F0", VD55G1_MODEL_ID_VD55G0 },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(acpi, vd55g1_acpi_ids);
+
 static const struct dev_pm_ops vd55g1_pm_ops = {
 	SET_RUNTIME_PM_OPS(vd55g1_power_off, vd55g1_power_on, NULL)
 };
@@ -2397,6 +2423,7 @@ static struct i2c_driver vd55g1_i2c_driver = {
 	.driver = {
 		.name  = "vd55g1",
 		.of_match_table = vd55g1_dt_ids,
+		.acpi_match_table = vd55g1_acpi_ids,
 		.pm = &vd55g1_pm_ops,
 	},
 	.probe = vd55g1_probe,
