Subject: media: ipu-bridge: add the Surface Pro 12 (Intel) cameras

- SONY0681 (IMX681, front): 969.6 MHz (linux-surface/kernel#176).
- The rear sensor (OVTID858) is mounted upside down but firmware reports
  no rotation; add the model to upside_down_sensor_dmi_ids
  (linux-surface/kernel#175).

Since 7.4 mainline has the OVTID858 entry (2ee01a094aba), with the same
540 and 270 MHz link frequencies this patch used to add.
---
diff --git a/drivers/media/pci/intel/ipu-bridge.c b/drivers/media/pci/intel/ipu-bridge.c
index 3739c4a2a8c4..5640370334fb 100644
--- a/drivers/media/pci/intel/ipu-bridge.c
+++ b/drivers/media/pci/intel/ipu-bridge.c
@@ -122,6 +122,8 @@ static const struct ipu_sensor_config ipu_supported_sensors[] = {
 	IPU_SENSOR_CONFIG("OVTI8856", 3, 180000000, 360000000, 720000000),
 	/* Sony IMX471 */
 	IPU_SENSOR_CONFIG("SONY471A", 1, 200000000),
+	/* Sony IMX681 */
+	IPU_SENSOR_CONFIG("SONY0681", 1, 969600000),
 	/* Sony IMX471 (found on Lenovo X1 Carbon G14) */
 	IPU_SENSOR_CONFIG("TBE20A0", 1, 200000000),
 	/* STMicroelectronics VD55G1 (found on Lenovo X1 Carbon G14) */
@@ -278,6 +280,15 @@ static const struct dmi_system_id upside_down_sensor_dmi_ids[] = {
 		},
 		.driver_data = "OVTID858",
 	},
+	{
+		.matches = {
+			DMI_EXACT_MATCH(DMI_SYS_VENDOR, "Microsoft Corporation"),
+			DMI_EXACT_MATCH(DMI_PRODUCT_NAME,
+					"Surface Pro for Business 13in 12th Ed Intel"),
+		},
+		/* OVTID858 is the rear camera on this model. */
+		.driver_data = "OVTID858",
+	},
 	{} /* Terminating entry */
 };
 
