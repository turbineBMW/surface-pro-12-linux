From 95f6c911455cd055493abcfa54bef37ac7a52f87 Mon Sep 17 00:00:00 2001
From: Brandon Williams <turbine.bmw@gmail.com>
Date: Mon, 9 Nov 2026 06:09:50 -0500
Subject: [PATCH] media: i2c: vd55g1: power the sensor off for system sleep

The driver has runtime PM callbacks only. Before a hibernation snapshot
the ACPI PM domain (acpi_subsys_freeze()) runtime-resumes every device,
so the sensor is powered on and booted when the image is taken, and the
image records it as runtime active. After the restore the sensor has
lost power and sits in READY_TO_BOOT, but runtime PM still considers it
on, so the first stream start writes its configuration to an unbooted
sensor and times out:

  vd55g1 i2c-SMO55F0:00: vd55g0 stream start failed -110: fsm=0x1 ...

The next open works only because the failed start drops the last
reference and the autosuspend powers the sensor off.

Use pm_runtime_force_suspend() and pm_runtime_force_resume() as the
system sleep callbacks, as other sensor drivers do. The sensor is then
powered off at freeze and marked suspended, and the first open after a
restore powers it on and boots it.

Assisted-by: Claude Opus 5.5
---
 drivers/media/i2c/vd55g1.c | 14 ++++++++++----
 1 file changed, 10 insertions(+), 4 deletions(-)

diff --git a/drivers/media/i2c/vd55g1.c b/drivers/media/i2c/vd55g1.c
index 65a5f2b5f8db..2cef99e570ba 100644
--- a/drivers/media/i2c/vd55g1.c
+++ b/drivers/media/i2c/vd55g1.c
@@ -2467,16 +2467,22 @@ static const struct acpi_device_id vd55g1_acpi_ids[] = {
 };
 MODULE_DEVICE_TABLE(acpi, vd55g1_acpi_ids);
 
-static const struct dev_pm_ops vd55g1_pm_ops = {
-	SET_RUNTIME_PM_OPS(vd55g1_power_off, vd55g1_power_on, NULL)
-};
+/*
+ * The system sleep callbacks power the sensor off. Before a hibernation
+ * snapshot the ACPI PM domain runtime-resumes every device, so without them
+ * the image records the sensor as powered and booted; after the restore the
+ * sensor has lost power and is back in READY_TO_BOOT, and the first stream
+ * start fails because runtime PM never boots it again.
+ */
+static DEFINE_RUNTIME_DEV_PM_OPS(vd55g1_pm_ops, vd55g1_power_off,
+				 vd55g1_power_on, NULL);
 
 static struct i2c_driver vd55g1_i2c_driver = {
 	.driver = {
 		.name  = "vd55g1",
 		.of_match_table = vd55g1_dt_ids,
 		.acpi_match_table = vd55g1_acpi_ids,
-		.pm = &vd55g1_pm_ops,
+		.pm = pm_ptr(&vd55g1_pm_ops),
 	},
 	.probe = vd55g1_probe,
 	.remove = vd55g1_remove,
-- 
