Subject: platform/surface: gpe: add Surface Pro 12 (Intel) lid GPE 0x30

Mark the lid GPE (0x30) of the Surface Pro 12 (Intel) for wake so that
opening the lid resumes the system from suspend.

As reported in linux-surface/linux-surface#2144.
---
diff --git a/drivers/platform/surface/surface_gpe.c b/drivers/platform/surface/surface_gpe.c
index 29b264f2a444..e3d5d4b57414 100644
--- a/drivers/platform/surface/surface_gpe.c
+++ b/drivers/platform/surface/surface_gpe.c
@@ -27,6 +27,11 @@ static const struct property_entry lid_device_props_l17[] = {
 	{},
 };
 
+static const struct property_entry lid_device_props_l30[] = {
+	PROPERTY_ENTRY_U32("gpe", 0x30),
+	{},
+};
+
 static const struct property_entry lid_device_props_l4B[] = {
 	PROPERTY_ENTRY_U32("gpe", 0x4B),
 	{},
@@ -192,6 +197,14 @@ static const struct dmi_system_id dmi_lid_device_table[] = {
 		},
 		.driver_data = (void *)lid_device_props_l4B,
 	},
+	{
+		.ident = "Surface Pro 12 (Intel)",
+		.matches = {
+			DMI_EXACT_MATCH(DMI_SYS_VENDOR, "Microsoft Corporation"),
+			DMI_EXACT_MATCH(DMI_PRODUCT_NAME, "Surface Pro for Business 13in 12th Ed Intel"),
+		},
+		.driver_data = (void *)lid_device_props_l30,
+	},
 	{ }
 };
 
