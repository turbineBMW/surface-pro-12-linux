From: turbinebmw <turbine.bmw@gmail.com>
Subject: platform/surface: platform_profile: Report the last profile when unset

The Surface Pro 12 (Intel) accepts TMP profile changes, but its get
request always answers 0, which is not a profile. Every read of
/sys/firmware/acpi/platform_profile then fails with EINVAL and logs
"invalid performance profile: 0", including the read the platform
profile core makes at registration and the one after each change
power-profiles-daemon makes.

Report the profile the driver last set when the EC answers 0 (UNSET),
starting from balanced. Other unknown values still fail as before.

On this device the profile does not appear to change the CPU power
limits: a fixed 4-thread compression job took the same time and the
RAPL limits stayed put between low-power and performance at a fixed
EPP. The profile is still sent, as it may steer the fan.
---
--- a/drivers/platform/surface/surface_platform_profile.c
+++ b/drivers/platform/surface/surface_platform_profile.c
@@ -15,7 +15,9 @@
 #include <linux/surface_aggregator/device.h>
 
 // Enum for the platform performance profile sent to the TMP module.
+// Some devices accept profiles but always report UNSET when asked.
 enum ssam_tmp_profile {
+	SSAM_TMP_PROFILE_UNSET              = 0,
 	SSAM_TMP_PROFILE_NORMAL             = 1,
 	SSAM_TMP_PROFILE_BATTERY_SAVER      = 2,
 	SSAM_TMP_PROFILE_BETTER_PERFORMANCE = 3,
@@ -42,6 +44,7 @@
 	struct ssam_device *sdev;
 	struct device *ppdev;
 	bool has_fan;
+	enum platform_profile_option last;	/* Last profile set. */
 };
 
 SSAM_DEFINE_SYNC_REQUEST_CL_R(__ssam_tmp_profile_get, struct ssam_tmp_profile_info, {
@@ -167,6 +170,15 @@
 	if (status)
 		return status;
 
+	/*
+	 * The Surface Pro 12 (Intel) reports UNSET whatever was set last. The
+	 * profile it was given is the best answer there is.
+	 */
+	if (tp == SSAM_TMP_PROFILE_UNSET) {
+		*profile = tpd->last;
+		return 0;
+	}
+
 	status = convert_ssam_tmp_to_profile(tpd->sdev, tp);
 	if (status < 0)
 		return status;
@@ -196,9 +208,12 @@
 		if (tp < 0)
 			return tp;
 		tp = ssam_fan_profile_set(tpd->sdev, tp);
+		if (tp < 0)
+			return tp;
 	}
 
-	return tp;
+	tpd->last = profile;
+	return 0;
 }
 
 static int ssam_platform_profile_probe(void *drvdata, unsigned long *choices)
@@ -229,6 +244,7 @@
 	ssam_device_set_drvdata(sdev, tpd);
 
 	tpd->has_fan = device_property_read_bool(&sdev->dev, "has_fan");
+	tpd->last = PLATFORM_PROFILE_BALANCED;
 
 	tpd->ppdev = devm_platform_profile_register(&sdev->dev, "Surface Platform Profile",
 						    tpd, &ssam_platform_profile_ops);
