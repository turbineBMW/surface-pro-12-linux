diff --git i/profiles/battery/battery.c w/profiles/battery/battery.c
index 2fe1f4a..17ea19f 100644
--- i/profiles/battery/battery.c
+++ w/profiles/battery/battery.c
@@ -40,6 +40,7 @@
 #include "src/service.h"
 #include "src/log.h"
 #include "src/battery.h"
+#include "src/sleep.h"
 #include "attrib/att.h"
 
 #define BATTERY_INTERFACE "org.bluez.Battery1"
@@ -59,10 +60,16 @@ struct batt {
 
 	uint8_t *initial_value;
 	uint8_t percentage;
+	bool paused;		/* Notifications off over system sleep */
 };
 
+/* Batteries with notifications set up, paused over system sleep */
+static struct queue *active_batts;
+static unsigned int sleep_id;
+
 static void batt_free(struct batt *batt)
 {
+	queue_remove(active_batts, batt);
 	gatt_db_unref(batt->db);
 	bt_gatt_client_unref(batt->client);
 	btd_device_unref(batt->device);
@@ -74,6 +81,9 @@ static void batt_free(struct batt *batt)
 
 static void batt_reset(struct batt *batt)
 {
+	queue_remove(active_batts, batt);
+	batt->batt_level_cb_id = 0;
+	batt->paused = false;
 	batt->attr = NULL;
 	batt->percentage = -1;
 	gatt_db_unref(batt->db);
@@ -144,6 +154,9 @@ static void batt_io_ccc_written_cb(uint16_t att_ecode, void *user_data)
 	g_free (batt->initial_value);
 	batt->initial_value = NULL;
 
+	if (!queue_find(active_batts, NULL, batt))
+		queue_push_tail(active_batts, batt);
+
 	DBG("Battery Level: notification enabled");
 }
 
@@ -185,6 +198,55 @@ static void handle_battery_level(struct batt *batt, uint16_t value_handle)
 		DBG("Failed to send request to read battery level");
 }
 
+/*
+ * Devices that stay connected over system sleep (e.g. keyboards kept for
+ * wakeup) would wake the host with each battery update, so turn the
+ * notifications off for the sleep and back on after it.
+ */
+static void batt_resumed_ccc_cb(uint16_t att_ecode, void *user_data)
+{
+	if (att_ecode)
+		error("Battery Level: notifications not re-enabled %s",
+		      att_ecode2str(att_ecode));
+}
+
+static void batt_suspend_one(void *data, void *user_data)
+{
+	struct batt *batt = data;
+
+	if (!batt->client || !batt->batt_level_cb_id)
+		return;
+
+	bt_gatt_client_unregister_notify(batt->client, batt->batt_level_cb_id);
+	batt->batt_level_cb_id = 0;
+	batt->paused = true;
+}
+
+static void batt_resume_one(void *data, void *user_data)
+{
+	struct batt *batt = data;
+
+	if (!batt->paused || !batt->client)
+		return;
+
+	batt->paused = false;
+	batt->batt_level_cb_id =
+		bt_gatt_client_register_notify(batt->client,
+					       batt->batt_level_io_handle,
+					       batt_resumed_ccc_cb,
+					       batt_io_value_cb, batt, NULL);
+}
+
+static void batt_sleep_suspend(void *user_data)
+{
+	queue_foreach(active_batts, batt_suspend_one, NULL);
+}
+
+static void batt_sleep_resume(void *user_data)
+{
+	queue_foreach(active_batts, batt_resume_one, NULL);
+}
+
 static bool uuid_cmp(uint16_t u16, const bt_uuid_t *uuid)
 {
 	bt_uuid_t lhs;
@@ -337,11 +399,18 @@ static struct btd_profile batt_profile = {
 
 static int batt_init(void)
 {
+	active_batts = queue_new();
+	sleep_id = btd_sleep_register(batt_sleep_suspend, batt_sleep_resume,
+									NULL);
+
 	return btd_profile_register(&batt_profile);
 }
 
 static void batt_exit(void)
 {
+	btd_sleep_unregister(sleep_id);
+	queue_destroy(active_batts, NULL);
+	active_batts = NULL;
 	btd_profile_unregister(&batt_profile);
 }
 
diff --git i/profiles/input/hog-lib.c w/profiles/input/hog-lib.c
index 70a1bdc..9516624 100644
--- i/profiles/input/hog-lib.c
+++ w/profiles/input/hog-lib.c
@@ -98,6 +98,8 @@ struct bt_hog {
 	struct queue		*gatt_op;
 	struct gatt_db		*gatt_db;
 	struct gatt_db_attribute	*report_map_attr;
+	/* Input report IDs in vendor-defined top-level collections */
+	uint8_t			vendor_input[32];
 };
 
 struct report {
@@ -986,6 +988,99 @@ fail:
 	report_reply(hog, err, 0, 0, NULL);
 }
 
+/*
+ * Note the input report IDs that belong to top-level collections with a
+ * vendor-defined usage page (0xff00-0xffff): status and configuration, not
+ * user input. They are paused over system sleep.
+ */
+static void mark_vendor_reports(struct bt_hog *hog, const uint8_t *map,
+								size_t len)
+{
+	uint32_t page = 0, top_page = 0;
+	uint8_t id = 0;
+	int depth = 0;
+	size_t i = 0;
+
+	memset(hog->vendor_input, 0, sizeof(hog->vendor_input));
+
+	while (i < len) {
+		uint8_t prefix = map[i];
+		uint8_t size, type, tag;
+		uint32_t data = 0;
+		size_t k;
+
+		if (prefix == 0xfe) {		/* long item */
+			if (i + 1 >= len)
+				break;
+			i += 3 + map[i + 1];
+			continue;
+		}
+
+		size = (prefix & 0x03) == 3 ? 4 : (prefix & 0x03);
+		type = (prefix >> 2) & 0x03;
+		tag = prefix >> 4;
+		if (i + 1 + size > len)
+			break;
+		for (k = 0; k < size; k++)
+			data |= (uint32_t) map[i + 1 + k] << (8 * k);
+		i += 1 + size;
+
+		if (type == 1 && tag == 0x0)		/* Usage Page */
+			page = data;
+		else if (type == 1 && tag == 0x8)	/* Report ID */
+			id = data;
+		else if (type == 0 && tag == 0xa) {	/* Collection */
+			if (depth++ == 0)
+				top_page = page;
+		} else if (type == 0 && tag == 0xc) {	/* End Collection */
+			if (depth > 0)
+				depth--;
+		} else if (type == 0 && tag == 0x8) {	/* Input */
+			if (id && top_page >= 0xff00)
+				hog->vendor_input[id / 8] |= 1 << (id % 8);
+		}
+	}
+}
+
+static bool is_vendor_input(struct bt_hog *hog, struct report *report)
+{
+	return report->type == HOG_REPORT_TYPE_INPUT && report->id &&
+		(hog->vendor_input[report->id / 8] & (1 << (report->id % 8)));
+}
+
+static void vendor_ccc_written_cb(guint8 status, const guint8 *pdu,
+					guint16 plen, gpointer user_data)
+{
+	struct gatt_request *req = user_data;
+
+	if (status)
+		error("hog: vendor report CCC write failed: %s",
+							att_ecode2str(status));
+
+	remove_gatt_req(req, status);
+}
+
+/* Turn vendor input report notifications off over sleep, on after it */
+static void set_vendor_reports(struct bt_hog *hog, bool suspend)
+{
+	uint8_t value[2];
+	GSList *l;
+
+	put_le16(suspend ? 0 : GATT_CLIENT_CHARAC_CFG_NOTIF_BIT, value);
+
+	for (l = hog->reports; l; l = l->next) {
+		struct report *r = l->data;
+
+		if (!r->ccc_handle || !is_vendor_input(hog, r))
+			continue;
+
+		DBG("%s notifications of vendor report 0x%02x",
+				suspend ? "Pausing" : "Resuming", r->id);
+		write_char(hog, hog->attrib, r->ccc_handle, value,
+				sizeof(value), vendor_ccc_written_cb, r);
+	}
+}
+
 static void uhid_create(struct bt_hog *hog, uint8_t *report_map,
 							size_t report_map_len)
 {
@@ -995,6 +1090,8 @@ static void uhid_create(struct bt_hog *hog, uint8_t *report_map,
 	GError *gerr = NULL;
 	bdaddr_t src, dst;
 
+	mark_vendor_reports(hog, report_map, report_map_len);
+
 	bt_io_get(g_attrib_get_channel(hog->attrib), &gerr,
 			BT_IO_OPT_SOURCE_BDADDR, &src,
 			BT_IO_OPT_DEST_BDADDR, &dst,
@@ -1803,17 +1900,30 @@ done:
 int bt_hog_set_control_point(struct bt_hog *hog, bool suspend)
 {
 	uint8_t value = suspend ? 0x00 : 0x01;
+	bool sent = false;
+	GSList *l;
+
+	if (!hog)
+		return -EINVAL;
 
 	if (hog->attrib == NULL)
 		return -ENOTCONN;
 
-	if (hog->ctrlpt_handle == 0)
-		return -ENOTSUP;
+	if (hog->ctrlpt_handle) {
+		gatt_write_cmd(hog->attrib, hog->ctrlpt_handle, &value,
+						sizeof(value), NULL, NULL);
+		sent = true;
+	}
 
-	gatt_write_cmd(hog->attrib, hog->ctrlpt_handle, &value,
-					sizeof(value), NULL, NULL);
+	/* Status reports that keep coming would still wake the host */
+	set_vendor_reports(hog, suspend);
 
-	return 0;
+	/* Devices with several HID services have a control point in each */
+	for (l = hog->instances; l; l = l->next)
+		if (!bt_hog_set_control_point(l->data, suspend))
+			sent = true;
+
+	return sent ? 0 : -ENOTSUP;
 }
 
 int bt_hog_send_report(struct bt_hog *hog, void *data, size_t size, int type)
diff --git i/profiles/input/hog.c w/profiles/input/hog.c
index f50a0f2..90fe3ab 100644
--- i/profiles/input/hog.c
+++ w/profiles/input/hog.c
@@ -116,6 +116,10 @@ static void set_suspend(gpointer data, gpointer user_data)
 	struct hog_device *dev = data;
