 }
 
diff --git i/profiles/input/suspend-sleep.c w/profiles/input/suspend-sleep.c
new file mode 100644
index 0000000..7f49eee
--- /dev/null
+++ w/profiles/input/suspend-sleep.c
@@ -0,0 +1,52 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ *
+ *  BlueZ - Bluetooth protocol stack for Linux
+ *
+ */
+
+#ifdef HAVE_CONFIG_H
+#include <config.h>
+#endif
+
+#include <errno.h>
+#include <stdlib.h>
+
+#include "src/sleep.h"
+#include "suspend.h"
+
+/* HoG suspend on system sleep, from logind (src/sleep.c) */
+
+static suspend_event suspend_cb;
+static resume_event resume_cb;
+static unsigned int sleep_id;
+
+static void on_suspend(void *user_data)
+{
+	if (suspend_cb)
+		suspend_cb();
+}
+
+static void on_resume(void *user_data)
+{
+	if (resume_cb)
+		resume_cb();
+}
+
+int suspend_init(suspend_event suspend, resume_event resume)
+{
+	suspend_cb = suspend;
+	resume_cb = resume;
+
+	sleep_id = btd_sleep_register(on_suspend, on_resume, NULL);
+
+	return sleep_id ? 0 : -ENOTSUP;
+}
+
+void suspend_exit(void)
+{
+	btd_sleep_unregister(sleep_id);
+	sleep_id = 0;
+	suspend_cb = NULL;
+	resume_cb = NULL;
+}
