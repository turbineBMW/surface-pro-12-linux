diff --git i/src/sleep.c w/src/sleep.c
new file mode 100644
index 0000000..189233c
--- /dev/null
+++ w/src/sleep.c
@@ -0,0 +1,243 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ *
+ *  BlueZ - Bluetooth protocol stack for Linux
+ *
+ */
+
+#ifdef HAVE_CONFIG_H
+#include <config.h>
+#endif
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+#include <glib.h>
+#include <dbus/dbus.h>
+
+#include "gdbus/gdbus.h"
+
+#include "src/shared/queue.h"
+#include "src/shared/util.h"
+#include "dbus-common.h"
+#include "log.h"
+#include "sleep.h"
+
+#define LOGIND_SERVICE		"org.freedesktop.login1"
+#define LOGIND_PATH		"/org/freedesktop/login1"
+#define LOGIND_MANAGER		"org.freedesktop.login1.Manager"
+
+/* Time for suspend writes to reach devices before sleep may proceed */
+#define SLEEP_RELEASE_MS	300
+
+struct sleep_listener {
+	unsigned int id;
+	btd_sleep_func_t suspend;
+	btd_sleep_func_t resume;
+	void *user_data;
+};
+
+static struct queue *listeners;
+static unsigned int next_id = 1;
+static guint signal_watch;
+static guint release_timer;
+static int inhibit_fd = -1;
+static bool suspended;
+
+static void release_inhibitor(void)
+{
+	if (inhibit_fd < 0)
+		return;
+
+	close(inhibit_fd);
+	inhibit_fd = -1;
+}
+
+static void inhibit_reply(DBusPendingCall *call, void *user_data)
+{
+	DBusMessage *reply = dbus_pending_call_steal_reply(call);
+	DBusError err;
+	int fd;
+
+	dbus_error_init(&err);
+
+	if (dbus_set_error_from_message(&err, reply)) {
+		error("sleep: logind inhibit failed: %s", err.message);
+		dbus_error_free(&err);
+		goto done;
+	}
+
+	if (!dbus_message_get_args(reply, &err, DBUS_TYPE_UNIX_FD, &fd,
+							DBUS_TYPE_INVALID)) {
+		error("sleep: invalid logind inhibit reply: %s", err.message);
+		dbus_error_free(&err);
+		goto done;
+	}
+
+	/* A sleep may have started while the call was pending */
+	if (suspended) {
+		close(fd);
+		goto done;
+	}
+
+	release_inhibitor();
+	inhibit_fd = fd;
+	DBG("sleep: delay inhibitor taken");
+
+done:
+	dbus_message_unref(reply);
+	dbus_pending_call_unref(call);
+}
+
+static void take_inhibitor(void)
+{
+	DBusConnection *conn = btd_get_dbus_connection();
+	const char *what = "sleep", *who = "bluetoothd";
+	const char *why = "Suspend connected Bluetooth input devices";
+	const char *mode = "delay";
+	DBusPendingCall *call;
+	DBusMessage *msg;
+
+	msg = dbus_message_new_method_call(LOGIND_SERVICE, LOGIND_PATH,
+						LOGIND_MANAGER, "Inhibit");
+	if (!msg)
+		return;
+
+	dbus_message_append_args(msg, DBUS_TYPE_STRING, &what,
+					DBUS_TYPE_STRING, &who,
+					DBUS_TYPE_STRING, &why,
+					DBUS_TYPE_STRING, &mode,
+					DBUS_TYPE_INVALID);
+
+	if (!dbus_connection_send_with_reply(conn, msg, &call, -1) || !call) {
+		error("sleep: unable to request logind inhibitor");
+		dbus_message_unref(msg);
+		return;
+	}
+
+	dbus_pending_call_set_notify(call, inhibit_reply, NULL, NULL);
+	dbus_message_unref(msg);
+}
+
+static gboolean release_timeout(gpointer user_data)
+{
+	release_timer = 0;
+	release_inhibitor();
+	DBG("sleep: delay inhibitor released");
+
+	return FALSE;
+}
+
+static void call_suspend(void *data, void *user_data)
+{
+	struct sleep_listener *l = data;
+
+	if (l->suspend)
+		l->suspend(l->user_data);
+}
+
+static void call_resume(void *data, void *user_data)
+{
+	struct sleep_listener *l = data;
+
+	if (l->resume)
+		l->resume(l->user_data);
+}
+
+static gboolean prepare_for_sleep(DBusConnection *conn, DBusMessage *msg,
+							void *user_data)
+{
+	dbus_bool_t start;
+
+	if (!dbus_message_get_args(msg, NULL, DBUS_TYPE_BOOLEAN, &start,
+							DBUS_TYPE_INVALID))
+		return TRUE;
+
+	if (start && !suspended) {
+		suspended = true;
+		DBG("sleep: suspending");
+		queue_foreach(listeners, call_suspend, NULL);
+
+		if (release_timer)
+			g_source_remove(release_timer);
+		release_timer = g_timeout_add(SLEEP_RELEASE_MS,
+						release_timeout, NULL);
+	} else if (!start && suspended) {
+		suspended = false;
+		DBG("sleep: resuming");
+
+		if (release_timer) {
+			g_source_remove(release_timer);
+			release_timer = 0;
+		}
+		release_inhibitor();
+
+		queue_foreach(listeners, call_resume, NULL);
+		take_inhibitor();
+	}
+
+	return TRUE;
+}
+
+unsigned int btd_sleep_register(btd_sleep_func_t suspend,
+				btd_sleep_func_t resume, void *user_data)
+{
+	struct sleep_listener *l;
+
+	if (!listeners)
+		return 0;
+
+	l = new0(struct sleep_listener, 1);
+	l->id = next_id++;
+	l->suspend = suspend;
+	l->resume = resume;
+	l->user_data = user_data;
+	queue_push_tail(listeners, l);
+
+	return l->id;
+}
+
+static bool match_id(const void *data, const void *match_data)
+{
+	const struct sleep_listener *l = data;
+
+	return l->id == PTR_TO_UINT(match_data);
+}
+
+void btd_sleep_unregister(unsigned int id)
+{
+	if (listeners)
+		queue_remove_all(listeners, match_id, UINT_TO_PTR(id), free);
+}
+
+void btd_sleep_init(void)
+{
+	DBusConnection *conn = btd_get_dbus_connection();
+
+	listeners = queue_new();
+
+	signal_watch = g_dbus_add_signal_watch(conn, LOGIND_SERVICE,
+						LOGIND_PATH, LOGIND_MANAGER,
+						"PrepareForSleep",
+						prepare_for_sleep, NULL, NULL);
+	take_inhibitor();
+}
+
+void btd_sleep_cleanup(void)
+{
+	DBusConnection *conn = btd_get_dbus_connection();
+
+	if (signal_watch)
+		g_dbus_remove_watch(conn, signal_watch);
+	signal_watch = 0;
+
+	if (release_timer)
+		g_source_remove(release_timer);
+	release_timer = 0;
+
+	release_inhibitor();
+	queue_destroy(listeners, free);
+	listeners = NULL;
+}
diff --git i/src/sleep.h w/src/sleep.h
new file mode 100644
index 0000000..ce3ce26
--- /dev/null
+++ w/src/sleep.h
@@ -0,0 +1,21 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ *
+ *  BlueZ - Bluetooth protocol stack for Linux
+ *
+ */
+
+/*
+ * System sleep notifications from systemd-logind. Suspend callbacks run
+ * while bluetoothd holds a short delay inhibitor, so what they send reaches
+ * connected devices before the system sleeps.
+ */
+
+typedef void (*btd_sleep_func_t)(void *user_data);
+
+unsigned int btd_sleep_register(btd_sleep_func_t suspend,
+				btd_sleep_func_t resume, void *user_data);
+void btd_sleep_unregister(unsigned int id);
