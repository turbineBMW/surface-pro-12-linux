 /*
+ * LIBCAMERA_SOFTISP_CNR: "0" turns chroma noise reduction off; otherwise the
+ * threshold (default 8): neighbours whose chroma (B - Y, R - Y, 8-bit output
+ * levels, half resolution) differs by more than this are left out of the
+ * average, so colour edges stay put while speckle is smoothed. Luma is kept.
+ */
+void DebayerCpu::configureCnr(const Size &outputSize)
+{
+	const char *env = utils::secure_getenv("LIBCAMERA_SOFTISP_CNR");
+	const int threshold = env ? atoi(env) : 8;
+	const unsigned int bpp = outputConfig_.bpp / 8;
+
+	cnrEnabled_ = threshold > 0 && (bpp == 3 || bpp == 4) &&
+		      outputSize.width >= 4 && outputSize.height >= 4;
+	cnrThreshold_ = threshold;
+	cnrSize_ = Size(outputSize.width / 2, outputSize.height / 2);
+	cnrIn_.clear();
+	cnrOut_.clear();
+	cnrColumns_.clear();
+	if (cnrEnabled_) {
+		/* Input plane padded by two on each side for the 5x5 filter */
+		cnrIn_.resize(static_cast<size_t>(cnrSize_.width + 4) * (cnrSize_.height + 4) * 2);
+		cnrOut_.resize(static_cast<size_t>(cnrSize_.width) * cnrSize_.height * 2);
+
+		/* Left chroma column and its 1/256 weight for each output column */
+		const int cw = cnrSize_.width;
+		for (int ox = 0; ox < 2 * cw; ox++) {
+			const int fx = std::clamp((2 * ox - 1) * 64, 0, (cw - 1) * 256);
+			const int xa = std::min(fx >> 8, cw - 2);
+			cnrColumns_.emplace_back(xa, fx - xa * 256);
+		}
+	}
+
+	LOG(Debayer, Info)
+		<< "Chroma noise reduction "
+		<< (cnrEnabled_ ? "on (threshold " + std::to_string(cnrThreshold_) + ")" : "off");
+}
+
+/* Run a chroma stage on every thread over its share of rows, and wait */
+void DebayerCpu::runOnThreads(unsigned int stage, uint8_t *dst)
+{
+	workPendingMutex_.lock();
+	workPending_ = (1 << threads_.size()) - 1;
+	workPendingMutex_.unlock();
+
+	for (auto &thread : threads_)
+		thread->invokeMethod(&DebayerCpuThread::chroma,
+				     ConnectionTypeQueued, stage, dst);
+
+	MutexLocker locker(workPendingMutex_);
+	workPendingCv_.wait(locker, [&]() LIBCAMERA_TSA_REQUIRES(workPendingMutex_) {
+		return workPending_ == 0;
+	});
+}
+
+/*
+ * Whether a small output bins the whole sensor (wide) rather than cropping
+ * its centre at full resolution. LIBCAMERA_SOFTISP_FOV ("wide" or "crop")
+ * wins; otherwise `fov=wide` in $XDG_CONFIG_HOME/sp12/camera.conf, read at
+ * each configure, so a change applies the next time a camera starts.
+ * Cropping is the default.
+ */
+bool DebayerCpu::wideFieldOfView() const
+{
+	const char *env = utils::secure_getenv("LIBCAMERA_SOFTISP_FOV");
+	if (env)
+		return !strcmp(env, "wide");
+
+	std::string path;
+	if (const char *xdg = utils::secure_getenv("XDG_CONFIG_HOME"); xdg && *xdg)
+		path = xdg;
+	else if (const char *home = utils::secure_getenv("HOME"); home && *home)
+		path = std::string(home) + "/.config";
+	else
+		return false;
+	path += "/sp12/camera.conf";
+
+	FILE *file = fopen(path.c_str(), "r");
+	if (!file)
+		return false;
+
+	bool wide = false;
+	char line[128];
+	while (fgets(line, sizeof(line), file)) {
+		char value[16];
+		if (sscanf(line, " fov = %15s", value) == 1)
+			wide = !strcmp(value, "wide");
+	}
+	fclose(file);
+
+	return wide;
+}
