+/*
+ * Chroma noise reduction, in stages over this thread's share of the half
+ * resolution rows: 0 computes the chroma of each 2x2 output block into a plane
+ * padded by two on each side, 1 filters it (a 5x5 sigma filter), 2 rebuilds
+ * the output pixels from their own luma and the filtered chroma, upsampled
+ * bilinearly.
+ */
+void DebayerCpuThread::chroma(unsigned int stage, uint8_t *dst)
+{
+	constexpr int kPad = 2;
+	const unsigned int stride = debayer_->outputConfig_.stride;
+	const unsigned int bpp = debayer_->outputConfig_.bpp / 8;
+	/* Byte positions of red and blue in an output pixel */
+	const unsigned int ri = debayer_->swapRedBlueGains_ ? 0 : 2;
+	const unsigned int bi = 2 - ri;
+	const int cw = debayer_->cnrSize_.width;
+	const int ch = debayer_->cnrSize_.height;
+	const int pw = cw + 2 * kPad;
+	const unsigned int threads = debayer_->threads_.size();
+	const int y0 = ch * threadIndex_ / threads;
+	const int y1 = ch * (threadIndex_ + 1) / threads;
+	int16_t *in = debayer_->cnrIn_.data();
+	int16_t *out = debayer_->cnrOut_.data();
+
+	auto luma = [](int r, int g, int b) { return (77 * r + 150 * g + 29 * b + 128) >> 8; };
+	auto padded = [&](int y) { return in + ((y + kPad) * pw + kPad) * 2; };
+
+	if (stage == 0) {
+		for (int y = y0; y < y1; y++) {
+			const uint8_t *l0 = dst + 2 * y * stride;
+			const uint8_t *l1 = l0 + stride;
+			int16_t *c = padded(y);
+
+			for (int x = 0; x < cw; x++) {
+				const uint8_t *p[4] = { l0 + 2 * x * bpp, l0 + (2 * x + 1) * bpp,
+							l1 + 2 * x * bpp, l1 + (2 * x + 1) * bpp };
+				int cb = 0, cr = 0;
+				for (const uint8_t *q : p) {
+					const int yv = luma(q[ri], q[1], q[bi]);
+					cb += q[bi] - yv;
+					cr += q[ri] - yv;
+				}
+				c[2 * x] = cb; /* x4 */
+				c[2 * x + 1] = cr;
+			}
+
+			/* Replicate the edge columns into the padding */
+			for (int k = 1; k <= kPad; k++) {
+				c[-2 * k] = c[0];
+				c[-2 * k + 1] = c[1];
+				c[2 * (cw - 1 + k)] = c[2 * (cw - 1)];
+				c[2 * (cw - 1 + k) + 1] = c[2 * (cw - 1) + 1];
+			}
+		}
+	} else if (stage == 1) {
+		/* Top and bottom padding rows, by the threads that read them */
+		if (y0 == 0)
+			for (int k = 1; k <= kPad; k++)
+				std::copy_n(padded(0) - 2 * kPad, pw * 2, padded(-k) - 2 * kPad);
+		if (y1 == ch)
+			for (int k = 1; k <= kPad; k++)
+				std::copy_n(padded(ch - 1) - 2 * kPad, pw * 2, padded(ch - 1 + k) - 2 * kPad);
+
+		const int thr = debayer_->cnrThreshold_ * 4;
+
+		for (int y = y0; y < y1; y++) {
+			const int16_t *c = padded(y);
+			int16_t *o = out + y * cw * 2;
+
+			for (int x = 0; x < cw; x++, c += 2, o += 2) {
+				const int c0 = c[0];
+				const int c1 = c[1];
+				int sumB = 0, sumR = 0, n = 0;
+				for (int dy = -kPad; dy <= kPad; dy++) {
+					const int16_t *q = c + (dy * pw - kPad) * 2;
+					for (int dx = 0; dx <= 2 * kPad; dx++, q += 2) {
+						/* All ones when the neighbour is close enough */
+						const int m = -(std::abs(q[0] - c0) + std::abs(q[1] - c1) <= thr);
+						sumB += q[0] & m;
+						sumR += q[1] & m;
+						n -= m;
+					}
+				}
+				o[0] = sumB / n;
+				o[1] = sumR / n;
+			}
+		}
+	} else {
+		/*
+		 * Rebuild output rows 2*y0 .. 2*y1 - 1. The upsampling reads the
+		 * filtered chroma of neighbouring rows, hence a separate stage.
+		 */
+		const std::vector<std::pair<int, int>> &cols = debayer_->cnrColumns_;
+
+		for (int oy = 2 * y0; oy < 2 * y1; oy++) {
+			/* Output pixel centres in half-resolution units of 1/256 */
+			const int fy = std::clamp((2 * oy - 1) * 64, 0, (ch - 1) * 256);
+			const int ya = std::min(fy >> 8, ch - 2);
+			const int wy = fy - ya * 256;
+			const int16_t *rowA = out + ya * cw * 2;
+			const int16_t *rowB = rowA + cw * 2;
+			uint8_t *p = dst + oy * stride;
+
+			for (int ox = 0; ox < 2 * cw; ox++, p += bpp) {
+				const auto [xa, wx] = cols[ox];
+				const int16_t *a = rowA + xa * 2;
+				const int16_t *b = rowB + xa * 2;
+				const int top0 = a[0] * (256 - wx) + a[2] * wx;
+				const int top1 = a[1] * (256 - wx) + a[3] * wx;
+				const int bot0 = b[0] * (256 - wx) + b[2] * wx;
+				const int bot1 = b[1] * (256 - wx) + b[3] * wx;
+				/* 1/65536 for the weights, 1/4 for the 2x2 sums */
+				const int cb = (top0 * (256 - wy) + bot0 * wy + (1 << 17)) >> 18;
+				const int cr = (top1 * (256 - wy) + bot1 * wy + (1 << 17)) >> 18;
+
+				const int yv = luma(p[ri], p[1], p[bi]);
+				const int r = std::clamp(yv + cr, 0, 255);
+				const int bl = std::clamp(yv + cb, 0, 255);
+				/* 437 / 65536 is 1 / 150 */
+				const int g = std::clamp(((256 * yv - 77 * r - 29 * bl) * 437 + 32768) >> 16, 0, 255);
+				p[ri] = r;
+				p[1] = g;
+				p[bi] = bl;
+			}
+		}
+	}
+
+	debayer_->workPendingMutex_.lock();
+	debayer_->workPending_ &= ~(1 << threadIndex_);
+	debayer_->workPendingMutex_.unlock();
+	debayer_->workPendingCv_.notify_one();
 }
 
