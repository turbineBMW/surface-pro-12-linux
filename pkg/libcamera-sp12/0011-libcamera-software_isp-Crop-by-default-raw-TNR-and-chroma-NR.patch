 /*
- * Apply lens shading to a copied raw line, padding included. The source line
- * pointer gives its row; rows just outside the window use the nearest one.
+ * Apply lens shading and temporal noise reduction to a copied raw line. The
+ * source line pointer gives its row. Shading covers the padding, and rows
+ * just outside the window use the nearest row's gains. Only rows this thread
+ * outputs are filtered, as each has one history; their neighbours from other
+ * threads are left as they are.
  */
-void DebayerCpuThread::shadeLine(uint8_t *line, const uint8_t *src)
+void DebayerCpuThread::processRawLine(uint8_t *line, const uint8_t *src)
 {
-	if (!debayer_->lscRaw_ || debayer_->lscMap_.empty())
-		return;
-
 	const int height = debayer_->window_.height;
-	const long row = std::clamp<long>((src - windowBase_) / static_cast<long>(debayer_->inputConfig_.stride),
-					  0, height - 1);
-	const uint16_t *gains = debayer_->lscMap_.data() + row * debayer_->lscMapStride_;
+	const long row = (src - windowBase_) / static_cast<long>(debayer_->inputConfig_.stride);
+	const unsigned int width = debayer_->window_.width;
+	const unsigned int pad = lineBufferPadding_ / 2;
 	uint16_t *pixels = reinterpret_cast<uint16_t *>(line);
 
-	for (unsigned int x = 0; x < debayer_->lscMapStride_; x++)
-		pixels[x] = debayer_->shade(pixels[x], gains[x]);
+	if (debayer_->lscRaw_ && !debayer_->lscMap_.empty()) {
+		const long gainRow = std::clamp<long>(row, 0, height - 1);
+		const uint16_t *gains = debayer_->lscMap_.data() + gainRow * debayer_->lscMapStride_;
+
+		for (unsigned int x = 0; x < debayer_->lscMapStride_; x++)
+			pixels[x] = debayer_->shade(pixels[x], gains[x]);
+	}
+
+	if (debayer_->tnrRaw_ && row >= static_cast<long>(yStart_) &&
+	    row < static_cast<long>(yEnd_)) {
+		uint16_t *hist = debayer_->tnrHistory_.data() + row * width;
+		uint16_t *p = pixels + pad;
+
+		for (unsigned int x = 0; x < width; x++)
+			p[x] = debayer_->temporalFilter(hist[x], p[x]);
+	}
+}
