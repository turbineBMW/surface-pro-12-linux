+ * B), 2048 = 1.0, spanning the full pixel array.
+ */
+struct LensShading {
+	struct Table {
+		std::array<float, 2> whitePoint;
+		std::array<std::vector<uint16_t>, 4> planes;
+	};
+	Size grid;
+	/* Pixel array the grid spans; empty when it is the input size */
+	Size arraySize;
+	float strength = 1.0f;
+	std::vector<Table> tables;
+};
