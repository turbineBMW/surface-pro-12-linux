+/*
+ * Read the optional top-level lensShading section of a tuning file. The IPA
+ * ignores top-level keys it doesn't know; the debayer applies the tables.
+ */
+std::optional<LensShading> readLensShading(const std::string &path)
+{
+	static constexpr std::array<const char *, 4> kPlanes = { "r", "gr", "gb", "b" };
+
+	File file(path);
+	if (!file.open(File::OpenModeFlag::ReadOnly))
+		return std::nullopt;
+
+	std::unique_ptr<ValueNode> root = YamlParser::parse(file);
+	if (!root || !root->contains("lensShading"))
+		return std::nullopt;
+
+	const ValueNode &node = (*root)["lensShading"];
+	std::optional<unsigned int> width = node["grid"][0].get<unsigned int>();
+	std::optional<unsigned int> height = node["grid"][1].get<unsigned int>();
+	if (!width || !height || *width < 2 || *height < 2) {
+		LOG(SoftwareIsp, Warning) << "Invalid lensShading grid in " << path;
+		return std::nullopt;
+	}
+
+	LensShading lensShading;
+	lensShading.grid = Size(*width, *height);
+	const std::size_t points = static_cast<std::size_t>(*width) * *height;
+
+	if (node.contains("arraySize")) {
+		std::optional<unsigned int> arrayWidth = node["arraySize"][0].get<unsigned int>();
+		std::optional<unsigned int> arrayHeight = node["arraySize"][1].get<unsigned int>();
+		if (arrayWidth && arrayHeight)
+			lensShading.arraySize = Size(*arrayWidth, *arrayHeight);
+	}
+	lensShading.strength = std::clamp(node["strength"].get<float>().value_or(1.0f), 0.0f, 1.0f);
+
+	for (const ValueNode &entry : node["tables"].asList()) {
+		LensShading::Table table;
