+/* Apply a lens-shading gain (2048 = 1.0) to the signal above black level. */
+inline int DebayerCpu::shade(int value, unsigned int gain) const
+{
+	if (value <= lscBlack_)
+		return value;
+
+	const int shaded = lscBlack_ + (((value - lscBlack_) * static_cast<int>(gain) + 1024) >> 11);
+	return std::min(shaded, rawMax_);
+}
+
+void DebayerCpu::setLensShading(LensShading lensShading)
+{
+	lensShading_ = std::move(lensShading);
+}
+
+/*
+ * Pick the lens-shading table whose white point is nearest the current white
+ * balance, rebuilding the gain map when that changes. Runs before the worker
+ * threads start on a frame.
+ */
+void DebayerCpu::updateLensShading(const DebayerParams &params)
+{
+	const float r = params.gains.r() > 0 ? params.gains.g() / params.gains.r() : 1.0f;
+	const float b = params.gains.b() > 0 ? params.gains.g() / params.gains.b() : 1.0f;
+
+	unsigned int best = 0;
+	float bestDist = std::numeric_limits<float>::max();
+	for (unsigned int i = 0; i < lensShading_.tables.size(); i++) {
+		const auto &wp = lensShading_.tables[i].whitePoint;
+		const float dist = (wp[0] - r) * (wp[0] - r) + (wp[1] - b) * (wp[1] - b);
+		if (dist < bestDist) {
+			bestDist = dist;
+			best = i;
+		}
+	}
+
+	lscBlack_ = std::lround(params.blackLevel.g() * (rawMax_ + 1));
+
+	if (static_cast<int>(best) != lscTable_)
+		buildLensShadingMap(best);
+}
+
+/*
+ * Gains (R, Gr, Gb, B) of a lens-shading table at input pixel (x, y). The grid
+ * spans the sensor pixel array; the input is taken to be that array scaled
+ * uniformly and centred, as sensor binned modes crop it.
+ */
+std::array<float, 4> DebayerCpu::lensShadingGains(const LensShading::Table &table,
+						  float x, float y) const
+{
+	const unsigned int gw = lensShading_.grid.width;
+	const unsigned int gh = lensShading_.grid.height;
+	const Size &array = lensShading_.arraySize.isNull() ? inputSize_
+							    : lensShading_.arraySize;
+	const float scale = static_cast<float>(array.width) / inputSize_.width;
+	const float xa = x * scale + (array.width - inputSize_.width * scale) / 2;
+	const float ya = y * scale + (array.height - inputSize_.height * scale) / 2;
+
+	const float gx = std::clamp(xa / array.width * (gw - 1), 0.0f, gw - 1.0f);
+	const float gy = std::clamp(ya / array.height * (gh - 1), 0.0f, gh - 1.0f);
+	const unsigned int x0 = std::min(static_cast<unsigned int>(gx), gw - 2);
+	const unsigned int y0 = std::min(static_cast<unsigned int>(gy), gh - 2);
+	const float fx = gx - x0;
+	const float fy = gy - y0;
+
+	std::array<float, 4> gains;
+	for (unsigned int c = 0; c < 4; c++) {
+		const std::vector<uint16_t> &plane = table.planes[c];
+		const float a = plane[y0 * gw + x0] * (1 - fx) + plane[y0 * gw + x0 + 1] * fx;
+		const float b = plane[(y0 + 1) * gw + x0] * (1 - fx) +
+				plane[(y0 + 1) * gw + x0 + 1] * fx;
+		gains[c] = std::pow((a * (1 - fy) + b * fy) / 2048.0f, lscStrength_);
+	}
+
+	return gains;
+}
+
+/*
+ * Resample one lens-shading table to the gains the debayer applies: one per
+ * binned output pixel and colour on the binned path, else one per raw pixel
+ * of the window plus the line-buffer padding either side.
+ */
+void DebayerCpu::buildLensShadingMap(unsigned int table)
+{
+	const LensShading::Table &t = lensShading_.tables[table];
+	auto q11 = [](float gain) {
+		return static_cast<uint16_t>(std::lround(std::min(gain, 31.0f) * 2048.0f));
+	};
+
+	if (binning_) {
+		const unsigned int width = window_.width / 2;
+		const unsigned int height = window_.height / 2;
+		/* Slots follow the binned function's r and b, swapped for BGR output */
+		const unsigned int redSlot = swapRedBlueGains_ ? 2 : 0;
+		const unsigned int blueSlot = 2 - redSlot;
+
+		lscMap_.resize(static_cast<size_t>(width) * height * 3);
+
+		for (unsigned int oy = 0; oy < height; oy++) {
+			uint16_t *row = lscMap_.data() + static_cast<size_t>(oy) * width * 3;
+
+			for (unsigned int ox = 0; ox < width; ox++) {
+				/* Centre of the 2x2 block */
+				const std::array<float, 4> g =
+					lensShadingGains(t, window_.x + 2 * ox + 1.0f,
+							 window_.y + 2 * oy + 1.0f);
+				row[ox * 3 + redSlot] = q11(g[0]);
+				row[ox * 3 + 1] = q11((g[1] + g[2]) / 2);
+				row[ox * 3 + blueSlot] = q11(g[3]);
+			}
+		}
+	} else {
+		/* Plane of each 2x2 position, [y & 1][x & 1] */
+		static constexpr std::array<std::array<unsigned int, 4>, 4> kPlanes = { {
+			{ 3, 2, 1, 0 }, /* BGGR */
+			{ 2, 3, 0, 1 }, /* GBRG */
+			{ 1, 0, 3, 2 }, /* GRBG */
+			{ 0, 1, 2, 3 }, /* RGGB */
+		} };
+		const std::array<unsigned int, 4> &planes = kPlanes[lscRawOrder_];
+		const int pad = inputConfig_.patternSize.width;
+
+		lscMapStride_ = window_.width + 2 * pad;
+		lscMap_.resize(static_cast<size_t>(lscMapStride_) * window_.height);
+
+		for (unsigned int y = 0; y < window_.height; y++) {
+			uint16_t *row = lscMap_.data() + static_cast<size_t>(y) * lscMapStride_;
+			const int ay = window_.y + y;
+
+			for (int x = -pad; x < static_cast<int>(window_.width) + pad; x++) {
+				const int ax = window_.x + x;
+				const std::array<float, 4> g = lensShadingGains(t, ax + 0.5f, ay + 0.5f);
+				row[x + pad] = q11(g[planes[(ay & 1) * 2 + (ax & 1)]]);
+			}
+		}
+	}
+
+	lscTable_ = table;
+	LOG(Debayer, Info)
+		<< "Lens shading table " << table << " (white point "
+		<< t.whitePoint[0] << ", " << t.whitePoint[1] << ")";
+}
