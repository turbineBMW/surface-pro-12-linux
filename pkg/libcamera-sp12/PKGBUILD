# libcamera 0.7.2 with IMX681 support for the Surface Pro 12 (Intel) front
# camera: sensor properties, the gain/black-level helper that simple-IPA AGC
# needs, initial tuning data, and an AGC exposure/gain threshold (1/60 s) to
# limit motion blur. Derived from Arch's libcamera PKGBUILD
# (David Runge, Carl Smedstad); builds only libcamera, libcamera-ipa and
# libcamera-tools, without docs, Qt, GStreamer or Python bindings.
# pkgrel 4.x replaces Arch's 0.7.2-4; any newer Arch release supersedes it.

pkgbase=libcamera
pkgname=(
  libcamera
  libcamera-ipa
  libcamera-tools
)
pkgver=0.7.2
pkgrel=4.8
pkgdesc="A complex camera support library for Linux, Android, and ChromeOS (with Surface Pro 12 IMX681 support)"
arch=(x86_64)
url="https://libcamera.org/"
_url=https://git.libcamera.org/libcamera/libcamera.git
makedepends=(
  cmake
  git
  gnutls
  libdrm
  libelf
  libevent
  libjpeg-turbo
  libtiff
  libunwind
  libyaml
  libyuv
  meson
  python-jinja
  python-ply
  python-pyyaml
  sdl2
  systemd
)
source=(
  "git+$_url#tag=v$pkgver"
  0001-libcamera-camera_sensor_properties-Add-IMX681.patch
  0002-libipa-camera_sensor_helper-Add-IMX681.patch
  0003-ipa-simple-Add-initial-IMX681-tuning-data.patch
  0004-ipa-simple-agc-Add-an-exposure-gain-threshold.patch
  0005-ipa-simple-imx681-Add-colour-correction-matrices.patch
  0006-ipa-simple-Add-OV13858-tuning-data.patch
  0007-libcamera-software_isp-debayer_cpu-Add-2x2-binning.patch
  0008-libcamera-software_isp-debayer_cpu-Add-temporal-noise-reduction.patch
  0009-libcamera-software_isp-Add-lens-shading-correction.patch
)
sha512sums=('a5656356617a01a7e8feb535380869d38b7c58139c7f99385af355629d3e1927bbd8847f7bec755c753c72f6b065df76de53c15f9af2e5901e83e7a144a2ddcd'
            SKIP
            SKIP
            SKIP
            SKIP
            SKIP
            SKIP
            SKIP
            SKIP
            SKIP)

_pick() {
  local p="$1" f d; shift
  for f; do
    [[ -e $f ]] || continue
    d="$srcdir/$p/${f#$pkgdir/}"
    mkdir -p "$(dirname "$d")"
    mv "$f" "$d"
    rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")"
  done
}

prepare() {
  cd $pkgbase
  local p
  for p in ../000*.patch; do
    patch -Np1 < "$p"
  done

  # add version, so that utils/gen-version.sh may rely on it
  printf "%s\n" "$pkgver" > .tarball-version
}

build() {
  local meson_options=(
    -D v4l2=enabled
    -D tracing=disabled
    -D test=false
    -D documentation=disabled
    -D pycamera=disabled
    -D gstreamer=disabled
    -D qcam=disabled
    -D lc-compliance=disabled
    -D cam=enabled
  )

  arch-meson $pkgbase build "${meson_options[@]}"
  meson compile -C build
}

package_libcamera() {
  license=(
    Apache-2.0
    CC0-1.0
    'GPL-2.0-only WITH Linux-syscall-note'
    GPL-2.0-or-later
    LGPL-2.1-or-later
    'GPL-2.0-or-later WITH Linux-syscall-note OR BSD-3-Clause'
    'GPL-2.0-or-later WITH Linux-syscall-note OR MIT'
  )
  depends=(
    glibc
    gnutls
    libcamera-ipa
    libelf
    libgcc
    libglvnd
    libstdc++
    libunwind
    libyaml
    libyuv
    sh
    systemd-libs libudev.so
  )
  optdepends=('libcamera-tools: for applications')
  provides=(libcamera.so libcamera-base.so)

  meson install -C build --destdir "$pkgdir"
  install -vDm 644 $pkgbase/LICENSES/{BSD-3-Clause,Linux-syscall-note,MIT}.txt -t "$pkgdir/usr/share/licenses/$pkgname/"

  (
    cd "$pkgdir"
    _pick $pkgbase-ipa usr/lib/libcamera/
    _pick $pkgbase-tools usr/bin/{cam,libcamera-bug-report}
  )
}

package_libcamera-ipa() {
  pkgdesc+=" - signed IPA"
  license=(
    BSD-2-Clause
    CC-BY-SA-4.0
    CC0-1.0
    GPL-2.0-or-later
    LGPL-2.1-or-later
  )
  depends=(
    glibc
    libcamera libcamera.so libcamera-base.so
    libgcc
    libstdc++
  )
  # stripping requires re-signing of IPA libs, so we do it manually
  options=(!strip)

  strip $pkgname/usr/lib/libcamera/*{.so,proxy}
  for _lib in $pkgname/usr/lib/libcamera/*.so; do
    $pkgbase/src/ipa/ipa-sign.sh "$(find build -type f -iname "*ipa-priv-key.pem")" "$_lib" "$_lib.sign"
  done
  mv -v $pkgname/* "$pkgdir"
  install -vDm 644 $pkgbase/LICENSES/BSD-2-Clause.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
}

package_libcamera-tools() {
  pkgdesc+=" - tools"
  license=(
    BSD-2-Clause
    CC0-1.0
    GPL-2.0-or-later
    LGPL-2.1-or-later
  )
  depends=(
    glibc
    libcamera libcamera.so libcamera-base.so
    libdrm
    libevent libevent-2.1.so libevent_pthreads-2.1.so
    libgcc
    libjpeg-turbo libjpeg.so
    libstdc++
    libtiff libtiff.so
    libyaml
    sdl2
  )

  mv -v $pkgname/* "$pkgdir"
  install -vDm 644 $pkgbase/LICENSES/BSD-2-Clause.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
}
