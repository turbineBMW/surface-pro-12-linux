 #include <stdint.h>
 
 #include <libcamera/base/log.h>
@@ -24,6 +27,12 @@ namespace ipa::softisp::algorithms {
  */
 static constexpr unsigned int kDefaultLux = 500;
 
+/* Grey zones darker than this fraction of the range are too noisy to use */
+static constexpr double kMinZoneLevel = 0.04;
+
+/* With fewer grey zones than this, the whole frame is used */
+static constexpr unsigned int kMinGreyZones = 8;
+
 class SoftIspAwbStats final : public AwbStats
 {
 public:
@@ -75,7 +84,124 @@ private:
  */
 int Awb::init(IPAContext &context, const ValueNode &tuningData)
 {
-	return awbAlgo_.init(tuningData, context.ctrlMap);
+	int ret = awbAlgo_.init(tuningData, context.ctrlMap);
+	if (ret)
+		return ret;
+
+	/*
+	 * Grey zones: with a `zoneDistance`, the statistics passed to the AWB
+	 * algorithm are averaged over the zones of the frame that could be
+	 * grey (lit, unsaturated, and within `zoneDistance` of the sensor's
+	 * white point locus) instead of over the whole frame, so that the
+	 * dominant colour of a scene does not set the white balance. The locus
+	 * is read from `colourGains`, the gains that make each illuminant
+	 * grey.
+	 */
+	if (!tuningData.contains("zoneDistance"))
+		return 0;
+
+	maxZoneDistance_ = tuningData["zoneDistance"].get<double>(0.0);
+	if (maxZoneDistance_ <= 0) {
+		LOG(IPASoftIspAwb, Error) << "Invalid zoneDistance";
+		return -EINVAL;
+	}
+
+	std::vector<std::pair<unsigned int, LocusPoint>> points;
+	for (const ValueNode &entry : tuningData["colourGains"].asList()) {
+		auto ct = entry["ct"].get<unsigned int>();
+		auto gains = entry["gains"].get<std::vector<double>>();
+		if (!ct || !gains || gains->size() != 2 ||
+		    (*gains)[0] <= 0 || (*gains)[1] <= 0) {
+			LOG(IPASoftIspAwb, Error) << "Invalid colourGains entry";
+			return -EINVAL;
+		}
+		points.push_back({ *ct, { 1.0 / (*gains)[0], 1.0 / (*gains)[1] } });
+	}
+
+	if (points.size() < 2) {
+		LOG(IPASoftIspAwb, Error)
+			<< "Grey zones need two colourGains entries or more";
+		return -EINVAL;
+	}
+
+	std::sort(points.begin(), points.end(),
+		  [](const auto &a, const auto &b) { return a.first < b.first; });
+	for (const auto &point : points)
+		locus_.push_back(point.second);
+
+	LOG(IPASoftIspAwb, Info)
+		<< "AWB grey zones within " << maxZoneDistance_
+		<< " of a locus of " << locus_.size() << " points";
+
+	return 0;
+}
+
+/*
+ * Distance from (r, b) to the nearest point of the locus polyline, in R/G and
+ * B/G units.
+ */
+double Awb::locusDistance(double r, double b) const
+{
+	double best = std::numeric_limits<double>::max();
+
+	for (unsigned int i = 0; i + 1 < locus_.size(); i++) {
+		const LocusPoint &p = locus_[i];
+		const LocusPoint &q = locus_[i + 1];
+		const double dr = q.r - p.r;
+		const double db = q.b - p.b;
+		const double len2 = dr * dr + db * db;
+		const double t = len2 > 0
+					 ? std::clamp(((r - p.r) * dr + (b - p.b) * db) / len2, 0.0, 1.0)
+					 : 0.0;
+		const double er = r - (p.r + t * dr);
+		const double eb = b - (p.b + t * db);
+		best = std::min(best, er * er + eb * eb);
+	}
+
+	return std::sqrt(best);
+}
+
+/*
+ * Average R/G and B/G over the zones that could be grey: lit, unsaturated,
+ * and with a colour near the locus. Brighter zones weigh more, as whites are
+ * the best reference. Return false when too few zones qualify.
+ */
+bool Awb::greyZoneRatios(uint8_t blackLevel, const SwIspStats *stats,
+			 double &r, double &b) const
+{
+	const double top = 250.0 - blackLevel;
+	double sumR = 0, sumG = 0, sumB = 0;
+	unsigned int used = 0;
+
+	for (const SwIspStats::AwbZone &zone : stats->awbZones) {
+		if (!zone[3])
+			continue;
+
+		const double n = zone[3];
+		const double zr = zone[0] / n - blackLevel;
+		const double zg = zone[1] / n - blackLevel;
+		const double zb = zone[2] / n - blackLevel;
+		if (zg < kMinZoneLevel * top || zr >= 0.95 * top ||
+		    zg >= 0.95 * top || zb >= 0.95 * top || zr <= 0 || zb <= 0)
+			continue;
+
+		if (locusDistance(zr / zg, zb / zg) > maxZoneDistance_)
+			continue;
+
+		sumR += zr * zg;
+		sumG += zg * zg;
+		sumB += zb * zg;
+		used++;
+	}
+
+	LOG(IPASoftIspAwb, Debug) << used << " grey zones";
+
+	if (used < kMinGreyZones)
+		return false;
+
+	r = sumR / sumG;
+	b = sumB / sumG;
+	return true;
 }
 
 /**
@@ -147,6 +273,11 @@ SoftIspAwbStats Awb::calculateRgbMeans(IPAContext &context,
 				   static_cast<double>(sum.g()) / nPixels,
 				   static_cast<double>(sum.b()) / nPixels } };
 
+	/* Keep the green mean, and take the colour from the grey zones. */
+	double r, b;
+	if (!locus_.empty() && greyZoneRatios(blackLevel, stats, r, b))
+		rgbMeans = { { r * rgbMeans.g(), rgbMeans.g(), b * rgbMeans.g() } };
+
 	return SoftIspAwbStats(rgbMeans);
 }
 
