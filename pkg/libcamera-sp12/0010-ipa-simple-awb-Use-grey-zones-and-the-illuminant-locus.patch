--- a/src/ipa/simple/algorithms/awb.cpp
+++ b/src/ipa/simple/algorithms/awb.cpp
@@ -7,6 +7,9 @@
 
 #include "awb.h"
 
+#include <algorithm>
+#include <cmath>
+#include <limits>
 #include <numeric>
 #include <stdint.h>
 
@@ -21,17 +24,111 @@
 
 LOG_DEFINE_CATEGORY(IPASoftAwb)
 
+namespace {
+
+/* Zones darker than this fraction of the range are too noisy to use */
+constexpr float kMinZoneLevel = 0.04f;
+/* Fewer usable zones than this, and grey world is used */
+constexpr unsigned int kMinZones = 8;
+
+} /* namespace */
+
 namespace ipa::soft::algorithms {
 
+/**
+ * \brief Read the optional illuminant locus
+ *
+ * Without tuning data the algorithm is plain grey world. With a `locus`, a
+ * list of { ct, r, b } giving the sensor's white point (R/G, B/G) at a colour
+ * temperature, the grey-world estimate is moved onto the nearest point of
+ * that curve, keeping at most `offLocus` of its distance from it (for
+ * fluorescent and LED tints), and the colour temperature is read from the
+ * curve instead of a generic sRGB estimate. `speed` (0..1) is the fraction
+ * of the way to a new estimate taken each frame. Only zones of the frame
+ * within `zoneDistance` of the locus count, when enough of them are.
+ */
+int Awb::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
+{
+	if (tuningData.contains("locus")) {
+		for (const ValueNode &entry : tuningData["locus"].asList()) {
+			auto ct = entry["ct"].get<unsigned int>();
+			auto r = entry["r"].get<float>();
+			auto b = entry["b"].get<float>();
+			if (!ct || !r || !b || *r <= 0 || *b <= 0) {
+				LOG(IPASoftAwb, Error) << "Invalid AWB locus point";
+				return -EINVAL;
+			}
+			locus_.push_back({ *ct, *r, *b });
+		}
+
+		std::sort(locus_.begin(), locus_.end(),
+			  [](const LocusPoint &a, const LocusPoint &b) { return a.ct < b.ct; });
+		if (locus_.size() < 2) {
+			LOG(IPASoftAwb, Error) << "The AWB locus needs two points or more";
+			return -EINVAL;
+		}
+	}
+
+	offLocus_ = std::max(tuningData["offLocus"].get<float>().value_or(0.0f), 0.0f);
+	maxZoneDistance_ = tuningData["zoneDistance"].get<float>().value_or(0.1f);
+	speed_ = std::clamp(tuningData["speed"].get<float>().value_or(1.0f), 0.01f, 1.0f);
+
+	if (!locus_.empty())
+		LOG(IPASoftAwb, Info)
+			<< "AWB locus of " << locus_.size() << " points, "
+			<< locus_.front().ct << "-" << locus_.back().ct << " K";
+
+	return 0;
+}
+
 int Awb::configure(IPAContext &context,
 		   [[maybe_unused]] const IPAConfigInfo &configInfo)
 {
 	auto &gains = context.activeState.awb.gains;
 	gains = { { 1.0, 1.0, 1.0 } };
+	estimate_.reset();
 
 	return 0;
 }
 
+/*
+ * Nearest point to (r, b) on the locus polyline, keeping up to offLocus of
+ * the distance from it, with the colour temperature of the nearest point.
+ */
+Awb::LocusPoint Awb::project(float r, float b, float offLocus) const
+{
+	LocusPoint best{ locus_.front().ct, locus_.front().r, locus_.front().b };
+	float bestDist = std::numeric_limits<float>::max();
+
+	for (unsigned int i = 0; i + 1 < locus_.size(); i++) {
+		const LocusPoint &p = locus_[i];
+		const LocusPoint &q = locus_[i + 1];
+		const float dr = q.r - p.r;
+		const float db = q.b - p.b;
+		const float len2 = dr * dr + db * db;
+		const float t = len2 > 0
+					? std::clamp(((r - p.r) * dr + (b - p.b) * db) / len2, 0.0f, 1.0f)
+					: 0.0f;
+		const float pr = p.r + t * dr;
+		const float pb = p.b + t * db;
+		const float dist = (r - pr) * (r - pr) + (b - pb) * (b - pb);
+		if (dist < bestDist) {
+			bestDist = dist;
+			best = { static_cast<unsigned int>(std::lround(p.ct + t * (static_cast<float>(q.ct) - p.ct))),
+				 pr, pb };
+		}
+	}
+
+	const float dist = std::sqrt(bestDist);
+	if (dist > 0) {
+		const float keep = std::min(dist, offLocus) / dist;
+		best.r += (r - best.r) * keep;
+		best.b += (b - best.b) * keep;
+	}
+
+	return best;
+}
+
 void Awb::prepare(IPAContext &context,
 		  [[maybe_unused]] const uint32_t frame,
 		  IPAFrameContext &frameContext,
@@ -73,19 +170,84 @@
 	 */
 	const RGB<uint64_t> sum = stats->sum_.max(offset + minValid) - offset;
 
-	/*
-	 * Calculate red and blue gains for AWB.
-	 * Clamp max gain at 4.0, this also avoids 0 division.
-	 */
 	auto &gains = context.activeState.awb.gains;
-	gains = { {
-		sum.r() <= sum.g() / 4 ? 4.0f : static_cast<float>(sum.g()) / sum.r(),
-		1.0,
-		sum.b() <= sum.g() / 4 ? 4.0f : static_cast<float>(sum.g()) / sum.b(),
-	} };
 
-	RGB<double> rgbGains{ { 1 / gains.r(), 1 / gains.g(), 1 / gains.b() } };
-	context.activeState.awb.temperatureK = estimateCCT(rgbGains);
+	if (locus_.empty()) {
+		/*
+		 * Calculate red and blue gains for AWB.
+		 * Clamp max gain at 4.0, this also avoids 0 division.
+		 */
+		gains = { {
+			sum.r() <= sum.g() / 4 ? 4.0f : static_cast<float>(sum.g()) / sum.r(),
+			1.0,
+			sum.b() <= sum.g() / 4 ? 4.0f : static_cast<float>(sum.g()) / sum.b(),
+		} };
+
+		RGB<double> rgbGains{ { 1 / gains.r(), 1 / gains.g(), 1 / gains.b() } };
+		context.activeState.awb.temperatureK = estimateCCT(rgbGains);
+	} else {
+		/*
+		 * Average the zones that could be grey: lit, unsaturated, and
+		 * with a colour near the locus. Brighter zones weigh more, as
+		 * whites are the best reference. Too few of them, and the
+		 * whole frame (grey world) is used instead.
+		 */
+		double zoneR = 0, zoneG = 0, zoneB = 0;
+		unsigned int used = 0;
+		for (const SwIspStats::AwbZone &zone : stats->awbZones) {
+			if (!zone[3])
+				continue;
+
+			const float n = zone[3];
+			const float zr = zone[0] / n - blackLevel;
+			const float zg = zone[1] / n - blackLevel;
+			const float zb = zone[2] / n - blackLevel;
+			const float top = 250.0f - blackLevel;
+			if (zg < kMinZoneLevel * top || zr >= 0.95f * top ||
+			    zg >= 0.95f * top || zb >= 0.95f * top || zr <= 0 || zb <= 0)
+				continue;
+
+			const LocusPoint nearest = project(zr / zg, zb / zg, 0.0f);
+			const float dr = zr / zg - nearest.r;
+			const float db = zb / zg - nearest.b;
+			if (dr * dr + db * db > maxZoneDistance_ * maxZoneDistance_)
+				continue;
+
+			zoneR += zr * zg;
+			zoneG += zg * zg;
+			zoneB += zb * zg;
+			used++;
+		}
+
+		float r, b;
+		if (used >= kMinZones) {
+			r = zoneR / zoneG;
+			b = zoneB / zoneG;
+		} else {
+			r = static_cast<float>(sum.r()) / sum.g();
+			b = static_cast<float>(sum.b()) / sum.g();
+		}
+		const LocusPoint target = project(std::max(r, 0.1f), std::max(b, 0.1f), offLocus_);
+
+		if (!estimate_) {
+			estimate_ = target;
+		} else {
+			estimate_->r += (target.r - estimate_->r) * speed_;
+			estimate_->b += (target.b - estimate_->b) * speed_;
+			estimate_->ct = std::lround(estimate_->ct +
+						    (static_cast<float>(target.ct) - estimate_->ct) * speed_);
+		}
+
+		LOG(IPASoftAwb, Debug)
+			<< used << " grey zones, estimate " << r << ", " << b
+			<< " -> " << target.r << ", " << target.b << " at " << target.ct << " K";
+
+		gains = { { std::clamp(1.0f / estimate_->r, 0.25f, 4.0f),
+			    1.0f,
+			    std::clamp(1.0f / estimate_->b, 0.25f, 4.0f) } };
+		context.activeState.awb.temperatureK = estimate_->ct;
+	}
+
 	metadata.set(controls::ColourTemperature, context.activeState.awb.temperatureK);
 
 	LOG(IPASoftAwb, Debug)
