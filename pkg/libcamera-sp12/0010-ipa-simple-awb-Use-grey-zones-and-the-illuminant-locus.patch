+	std::vector<LocusPoint> locus_;
+	float offLocus_ = 0.0f;
+	float maxZoneDistance_ = 0.1f;
+	float speed_ = 1.0f;
+	std::optional<LocusPoint> estimate_;
 };
 
 } /* namespace ipa::soft::algorithms */
