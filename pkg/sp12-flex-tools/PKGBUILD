# Surface Pro 12 (Intel) userspace: Flex Keyboard Bluetooth pairing over the
# wired connector, reconnect on detach and Bluetooth touchpad/keyboard
# integration; Slim Pen pairing and Windows bond import; the libcamera software-ISP default and the
# front camera field-of-view switch; the battery charge limit; keyboard wake;
# the OLED PSR setting; the IR
# camera wiring; and the ambient light sensor stream.
# Sources: ../../userspace.

pkgname=sp12-flex-tools
pkgver=1.20
pkgrel=1
pkgdesc="Surface Pro 12 (Intel): Flex Keyboard Bluetooth OOB pairing, reconnect-on-detach, camera ISP default, battery charge limit, keyboard wake, IR camera wiring, ambient light stream"
arch=('any')
license=('MIT')
options=('!debug')
depends=('python' 'bluez' 'bluez-utils' 'v4l-utils' 'sp12-modules-dkms')
optdepends=('libcamera: cameras' 'pipewire-libcamera: cameras in PipeWire apps and browsers')

package() {
	local u="${startdir}/../../userspace"
	install -Dm755 "$u/usr/local/bin/sp12-flex-pair" "${pkgdir}/usr/bin/sp12-flex-pair"
	install -Dm755 "$u/usr/local/bin/sp12-pen-pair" "${pkgdir}/usr/bin/sp12-pen-pair"
	install -Dm755 "$u/usr/local/bin/sp12-bt-import-windows" "${pkgdir}/usr/bin/sp12-bt-import-windows"
	install -Dm755 "$u/usr/local/bin/sp12-camera-fov" "${pkgdir}/usr/bin/sp12-camera-fov"
	install -Dm755 "$u/usr/local/bin/sp12-charge-limit" "${pkgdir}/usr/bin/sp12-charge-limit"
	install -Dm644 "$u/usr/lib/udev/rules.d/70-sp12-charge-limit.rules" \
		"${pkgdir}/usr/lib/udev/rules.d/70-sp12-charge-limit.rules"
	install -Dm644 "$u/usr/lib/udev/rules.d/70-sp12-keyboard-wake.rules" \
		"${pkgdir}/usr/lib/udev/rules.d/70-sp12-keyboard-wake.rules"
	install -Dm755 "$u/usr/local/libexec/sp12-flex-bt-autoconnect" \
		"${pkgdir}/usr/lib/sp12/sp12-flex-bt-autoconnect"
	install -Dm644 "$u/etc/udev/rules.d/99-sp12-flex-bt.rules" \
		"${pkgdir}/usr/lib/udev/rules.d/99-sp12-flex-bt.rules"
	install -Dm644 "$u/usr/lib/environment.d/60-sp12-libcamera.conf" \
		"${pkgdir}/usr/lib/environment.d/60-sp12-libcamera.conf"
	install -Dm755 "$u/usr/lib/sp12/sp12-ir-graph" "${pkgdir}/usr/lib/sp12/sp12-ir-graph"
	install -Dm644 "$u/usr/lib/systemd/system/sp12-ir-camera.service" \
		"${pkgdir}/usr/lib/systemd/system/sp12-ir-camera.service"
	install -Dm644 "$u/usr/lib/udev/rules.d/70-sp12-ir-camera.rules" \
		"${pkgdir}/usr/lib/udev/rules.d/70-sp12-ir-camera.rules"
	install -Dm755 "$u/usr/lib/sp12/sp12-als" "${pkgdir}/usr/lib/sp12/sp12-als"
	install -Dm644 "$u/usr/lib/systemd/system/sp12-als.service" \
		"${pkgdir}/usr/lib/systemd/system/sp12-als.service"
	install -Dm644 "$u/usr/lib/udev/rules.d/70-sp12-als.rules" \
		"${pkgdir}/usr/lib/udev/rules.d/70-sp12-als.rules"
	install -Dm644 "$u/usr/lib/modprobe.d/sp12-display.conf" \
		"${pkgdir}/usr/lib/modprobe.d/sp12-display.conf"
	install -Dm644 "$u/usr/lib/udev/hwdb.d/61-sp12-flex-touchpad.hwdb" \
		"${pkgdir}/usr/lib/udev/hwdb.d/61-sp12-flex-touchpad.hwdb"
	install -Dm644 "$u/usr/share/libinput/60-sp12-flex-keyboard.quirks" \
		"${pkgdir}/usr/share/libinput/60-sp12-flex-keyboard.quirks"
	sed 's|/usr/local/libexec/sp12-flex-bt-autoconnect|/usr/lib/sp12/sp12-flex-bt-autoconnect|' \
		"$u/etc/systemd/system/sp12-flex-bt-connect.service" \
		| install -Dm644 /dev/stdin "${pkgdir}/usr/lib/systemd/system/sp12-flex-bt-connect.service"
}
