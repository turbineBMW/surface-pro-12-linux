# Flex Keyboard Bluetooth pairing over the wired connector and reconnect on
# detach, for the Surface Pro 12 (Intel). Sources: ../../userspace.

pkgname=sp12-flex-tools
pkgver=1.0
pkgrel=1
pkgdesc="Surface Pro 12 (Intel): Flex Keyboard Bluetooth OOB pairing and reconnect-on-detach"
arch=('any')
license=('MIT')
options=('!debug')
depends=('python' 'bluez' 'bluez-utils' 'sp12-modules-dkms')

package() {
	local u="${startdir}/../../userspace"
	install -Dm755 "$u/usr/local/bin/sp12-flex-pair" "${pkgdir}/usr/bin/sp12-flex-pair"
	install -Dm755 "$u/usr/local/libexec/sp12-flex-bt-autoconnect" \
		"${pkgdir}/usr/lib/sp12/sp12-flex-bt-autoconnect"
	install -Dm644 "$u/etc/udev/rules.d/99-sp12-flex-bt.rules" \
		"${pkgdir}/usr/lib/udev/rules.d/99-sp12-flex-bt.rules"
	sed 's|/usr/local/libexec/sp12-flex-bt-autoconnect|/usr/lib/sp12/sp12-flex-bt-autoconnect|' \
		"$u/etc/systemd/system/sp12-flex-bt-connect.service" \
		| install -Dm644 /dev/stdin "${pkgdir}/usr/lib/systemd/system/sp12-flex-bt-connect.service"
}
