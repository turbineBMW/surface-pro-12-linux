# Surface Pro 12 (Intel) kernel modules, built by DKMS for every installed
# kernel with headers. Sources: ../../dkms. SP12_CACHE_KVERS lists kernel
# releases whose sources are bundled for offline builds (e.g. an ISO install).

pkgname=sp12-modules-dkms
pkgver=1.13
pkgrel=1
pkgdesc="Surface Pro 12 (Intel): SSAM registry (Flex Keyboard, battery), tablet switch, lid wake, Bluetooth LE OOB pairing, chassis buttons, NFC, cameras incl. IR, battery charge limit, keyboard wake (DKMS)"
arch=('any')
url="https://github.com/linux-surface/linux-surface/issues/2144"
license=('GPL-2.0-only')
options=('!debug')
depends=('dkms' 'git' 'patch')

build() {
	rm -rf tree
	cp -r "${startdir}/../../dkms" tree
	cd tree
	rm -rf cache src surface bluetooth input nfc media bridge ipu7 power
	grep -q "^PACKAGE_VERSION=\"${pkgver}\"" dkms.conf
	for k in ${SP12_CACHE_KVERS:-}; do
		./prepare-sources.sh --cache "$k"
	done
}

package() {
	local d="${pkgdir}/usr/src/sp12-modules-${pkgver}"
	cd tree
	install -Dm644 dkms.conf Makefile -t "$d"
	install -Dm755 prepare-sources.sh -t "$d"
	install -Dm644 patches/*.patch -t "$d/patches"
	if [ -d cache ]; then
		install -Dm644 cache/*.tar.gz -t "$d/cache"
	fi
}
