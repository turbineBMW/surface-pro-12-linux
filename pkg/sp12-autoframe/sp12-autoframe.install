# Both relays use sp12bt601 (0.8); the front also sp12autoframe.
_relays="v4l2-relayd@sp12-front.service v4l2-relayd@sp12-rear.service"

post_install() {
	systemd-tmpfiles --create sp12-autoframe.conf
	systemctl daemon-reload
	systemctl try-restart $_relays 2>/dev/null || true
	cat <<'EOF'
sp12-autoframe: the "Surface Front Camera (ISP)" now follows your face.
  sp12-autoframe off | auto        switch, applies to the running camera
  sp12-autoframe --face 0.40       tighter (0.30 default, 0.22 loose)
  sp12-autoframe status            mode and settings in force
Settings are saved per user and restored at login (sp12-autoframe.service).
Omarchy bar widget (toggle + sliders), as the desktop user:
  sp12-autoframe plugin install
EOF
}

post_upgrade() {
	systemd-tmpfiles --create sp12-autoframe.conf
	systemctl daemon-reload
	# Before 0.5 the relay file was a *.conf in /etc/v4l2-relayd.d, which the
	# relay's generator started as a bogus instance of its own at every boot.
	systemctl stop v4l2-relayd@sp12-front-autoframe.service 2>/dev/null || true
	systemctl reset-failed v4l2-relayd@sp12-front-autoframe.service 2>/dev/null || true
	systemctl try-restart $_relays 2>/dev/null || true
}

post_remove() {
	systemctl daemon-reload
	systemctl try-restart $_relays 2>/dev/null || true
}
