+} __attribute__((packed)) memdbg;
+
+static void memdbg_flush(uint32_t stage) {
+    if (memdbg.writes >= 200) {
+        return;
+    }
+    memdbg.writes++;
+    memdbg.stage = stage;
+    memdbg.usec = rdtsc_usec();
+    gRT->SetVariable(L"LimineMemDbg", &limine_efi_vendor_guid,
+                     EFI_VARIABLE_NON_VOLATILE | EFI_VARIABLE_BOOTSERVICE_ACCESS | EFI_VARIABLE_RUNTIME_ACCESS,
+                     sizeof(memdbg), &memdbg);
+}
+
+static EFI_STATUS memdbg_alloc(EFI_PHYSICAL_ADDRESS base, UINTN pages, uint32_t stage) {
+    EFI_PHYSICAL_ADDRESS alloc_base = base;
+    memdbg.claim_calls++;
+    memdbg.last_base = base;
+    memdbg.last_pages = pages;
+    // Record the call before making it too, so a call that never returns is
+    // visible as the last write.
+    if ((memdbg.claim_calls & 0xffff) == 1) {
+        memdbg_flush(stage);
+    }
+    EFI_STATUS status = gBS->AllocatePages(AllocateAddress, EfiLoaderCode, pages, &alloc_base);
+    if (status) {
+        memdbg.claim_fails++;
+        if (memdbg.claim_fails == 1) {
+            memdbg.first_fail_base = base;
+            memdbg.first_fail_pages = pages;
+            memdbg.first_fail_status = status;
+            memdbg_flush(stage + 1);
+        }
+    }
+    return status;
+}
