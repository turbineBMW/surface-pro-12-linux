# Bluetooth HCI captures contain pairing keys.
captures/
*.snoop

# Microsoft firmware and anything else that must not be published.
private/
*.bin

# Build outputs and external checkouts.
pkg/*/src/
pkg/*/pkg/
pkg/limine/Limine/
pkg/limine-arch/
pkg/libcamera-sp12/libcamera/
pkg/pipewire-libcamera-sp12/pipewire/
pkg/bluez-sp12/bluez/
pkg/*/*.tar.gz
pkg/*/build.log
pkg/out/
*.pkg.tar.*
*.iso
*.efi

# First hand-built module attempt, superseded by dkms/.
ssam-modules/

# QEMU / Project Mu reproduction working files.
limine/qemu/mu_tiano_platforms/
limine/qemu/out/
limine/qemu/esp/
limine/qemu/*.log

# Python bytecode caches.
__pycache__/

# Kernel module build run in place (dkms/psys is built from its own dir).
dkms/psys/*.o
dkms/psys/*.ko
dkms/psys/*.mod
dkms/psys/*.mod.c
dkms/psys/.*.cmd
dkms/psys/Module.symvers
dkms/psys/modules.order
